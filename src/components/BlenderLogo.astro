---
import { Image } from "astro:assets";
import environmentUrl from "../assets/environments/studio-kontrast-02-1k.hdr";
import logoMark from "../assets/images/brand/mark.svg";
import modelUrl from "../assets/models/logo-v2.glb";
---

<figure
  class="model-viewer"
  data-model-url={modelUrl}
  data-environment-url={environmentUrl}
  role="img"
  aria-label="Omniwerx® logo"
>
  <Image
    class="model-fallback"
    src={logoMark}
    alt=""
    width="240"
    height="240"
    aria-hidden="true"
  />
  <canvas aria-hidden="true"></canvas>
</figure>

<script>
  const viewers = document.querySelectorAll<HTMLElement>(".model-viewer");

  for (const viewer of viewers) {
    let disposed = false;
    let cleanup: (() => void) | undefined;
    let observer: IntersectionObserver | undefined;

    const initialize = async () => {
      observer?.disconnect();

      try {
        const { initializeBlenderLogo } =
          await import("../scripts/blender-logo-viewer.js");
        if (disposed || !viewer.isConnected) return;
        cleanup = initializeBlenderLogo(viewer);
      } catch {
        // The SVG logo remains visible if WebGL cannot be initialized.
      }
    };

    if ("IntersectionObserver" in window) {
      observer = new IntersectionObserver(
        (entries) => {
          if (entries.some((entry) => entry.isIntersecting)) void initialize();
        },
        { rootMargin: "320px 0px", threshold: 0.01 },
      );
      observer.observe(viewer);
    } else {
      void initialize();
    }

    document.addEventListener(
      "astro:before-swap",
      () => {
        disposed = true;
        observer?.disconnect();
        cleanup?.();
      },
      { once: true },
    );
  }
</script>

<style>
  .model-viewer {
    position: relative;
    z-index: 3;
    width: 100%;
    height: 100%;
    max-height: 32rem;
    overflow: hidden;
  }

  .model-fallback {
    position: absolute;
    inset: 50% auto auto 50%;
    inline-size: min(62.5%, 15rem);
    block-size: auto;
    opacity: 1;
    transform: translate(-50%, -50%);
    transition-property: opacity, visibility;
    transition-duration: 180ms;
    transition-timing-function: var(--bezier);
  }

  canvas {
    display: block;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 180ms var(--bezier);
  }

  @media (hover: none) and (pointer: coarse) {
    .model-viewer {
      touch-action: none;
    }
  }

  .model-viewer[data-ready] .model-fallback {
    opacity: 0;
    visibility: hidden;
  }

  .model-viewer[data-ready] canvas {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .model-fallback,
    canvas {
      transition-duration: 0s;
    }
  }
</style>
