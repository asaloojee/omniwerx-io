---
import environmentUrl from "../assets/studio_kontrast_02_1k.hdr";
import modelUrl from "../assets/logo-v2.glb";
---

<figure
  class="model-viewer"
  data-model-url={modelUrl}
  data-environment-url={environmentUrl}
>
  <canvas role="img" aria-label="Omniwerx logo"></canvas>
  <p class="model-status" role="status">Loading 3D model…</p>
</figure>

<script>
  import * as THREE from "three";
  import { DRACOLoader } from "three/addons/loaders/DRACOLoader.js";
  import { GLTFLoader } from "three/addons/loaders/GLTFLoader.js";
  import { RGBELoader } from "three/addons/loaders/RGBELoader.js";
  import { OrbitControls } from "three/addons/controls/OrbitControls.js";

  const viewers = document.querySelectorAll<HTMLElement>(".model-viewer");

  for (const viewer of viewers) {
    const canvas = viewer.querySelector<HTMLCanvasElement>("canvas");
    const status = viewer.querySelector<HTMLElement>(".model-status");
    const modelUrl = viewer.dataset.modelUrl;
    const environmentUrl = viewer.dataset.environmentUrl;

    if (!canvas || !status || !modelUrl || !environmentUrl) continue;

    try {
      const renderer = new THREE.WebGLRenderer({
        canvas,
        alpha: true,
        antialias: true,
        powerPreference: "high-performance",
      });
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
      renderer.outputColorSpace = THREE.SRGBColorSpace;
      renderer.toneMapping = THREE.ACESFilmicToneMapping;
      renderer.toneMappingExposure = 0.8;

      const scene = new THREE.Scene();
      scene.environmentIntensity = 0.8;
      const camera = new THREE.PerspectiveCamera(30, 1, 0.01, 10);
      camera.position.setFromSpherical(
        new THREE.Spherical(
          1,
          THREE.MathUtils.degToRad(72),
          THREE.MathUtils.degToRad(20),
        ),
      );

      const modelRoot = new THREE.Group();
      modelRoot.rotation.x = THREE.MathUtils.degToRad(90);
      scene.add(modelRoot);
      scene.add(new THREE.HemisphereLight(0xffffff, 0x282020, 0.6));

      const reduceMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      );
      const controls = new OrbitControls(camera, canvas);
      controls.enableDamping = !reduceMotion.matches;
      controls.enablePan = false;
      controls.enableZoom = false;
      canvas.style.touchAction = "pan-y";

      let animationFrame = 0;
      let environment: THREE.DataTexture | undefined;
      let model: THREE.Object3D | undefined;
      let modelRadius = 0;

      const frameCamera = () => {
        if (!modelRadius) return;

        const verticalFov = THREE.MathUtils.degToRad(camera.fov);
        const horizontalFov =
          2 * Math.atan(Math.tan(verticalFov / 2) * camera.aspect);
        const fitFov = Math.min(verticalFov, horizontalFov);
        const distance = (modelRadius / Math.sin(fitFov / 2)) * 1.08;

        camera.position.setLength(distance);
        controls.update();
      };

      const dracoLoader = new DRACOLoader();
      dracoLoader.setDecoderPath(`${import.meta.env.BASE_URL}draco/`);

      const gltfLoader = new GLTFLoader();
      gltfLoader.setDRACOLoader(dracoLoader);

      const resize = () => {
        const { width, height } = viewer.getBoundingClientRect();
        if (!width || !height) return;

        renderer.setSize(width, height, false);
        camera.aspect = width / height;
        camera.setViewOffset(width, height, -width * 0.1, 0, width, height);
        frameCamera();
      };

      const resizeObserver = new ResizeObserver(resize);
      resizeObserver.observe(viewer);
      resize();

      const render = () => {
        controls.update();
        renderer.render(scene, camera);
        animationFrame = requestAnimationFrame(render);
      };

      new RGBELoader().load(
        environmentUrl,
        (texture) => {
          environment = texture;
          texture.mapping = THREE.EquirectangularReflectionMapping;
          scene.environment = texture;
        },
        undefined,
        () => {
          // The hemisphere light remains as a usable fallback.
        },
      );

      gltfLoader.load(
        modelUrl,
        (gltf) => {
          model = gltf.scene;
          modelRoot.add(model);

          const sphere = new THREE.Box3()
            .setFromObject(model)
            .getBoundingSphere(new THREE.Sphere());
          modelRadius = sphere.radius;
          model.position.sub(sphere.center);
          frameCamera();

          status.hidden = true;
          animationFrame = requestAnimationFrame(render);
        },
        undefined,
        () => {
          status.textContent = "The 3D model could not be loaded.";
        },
      );

      const cleanup = () => {
        cancelAnimationFrame(animationFrame);
        resizeObserver.disconnect();
        environment?.dispose();
        controls.dispose();
        dracoLoader.dispose();
        model?.traverse((object) => {
          if (!(object instanceof THREE.Mesh)) return;
          object.geometry.dispose();
          const materials = Array.isArray(object.material)
            ? object.material
            : [object.material];
          for (const material of materials) material.dispose();
        });
        renderer.dispose();
      };

      document.addEventListener("astro:before-swap", cleanup, { once: true });
    } catch {
      status.textContent = "This browser cannot display the 3D model.";
    }
  }
</script>

<style>
  .model-viewer {
    position: relative;
    width: 100%;
    height: 28rem;
    overflow: hidden;
    grid-area: badge;
  }

  canvas {
    display: block;
    width: 100%;
    height: 100%;
    cursor: grab;
  }

  canvas:active {
    cursor: grabbing;
  }

  .model-status {
    position: absolute;
    inset: 50% auto auto 50%;
    color: var(--body-text);
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
    transform: translate(-50%, -50%);
  }
</style>
