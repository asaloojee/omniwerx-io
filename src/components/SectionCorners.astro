---
interface Props {
  position?: "top" | "bottom";
}

const { position = "bottom" } = Astro.props;
---

<svg
  class:list={[
    "section-corner",
    "section-corner--start",
    `section-corner--${position}`,
  ]}
  width="7"
  height="7"
  viewBox="0 0 7 7"
  aria-hidden="true"
>
  <rect
    x="0.5"
    y="0.5"
    width="6"
    height="6"
    rx="1.4"
    fill="var(--primary-black)"
    stroke="var(--border-color)"
    stroke-width="1"></rect>
</svg>
<svg
  class:list={[
    "section-corner",
    "section-corner--end",
    `section-corner--${position}`,
  ]}
  width="7"
  height="7"
  viewBox="0 0 7 7"
  aria-hidden="true"
>
  <rect
    x="0.5"
    y="0.5"
    width="6"
    height="6"
    rx="1.4"
    fill="var(--primary-black)"
    stroke="var(--border-color)"
    stroke-width="1"></rect>
</svg>

<style>
  .section-corner {
    position: absolute;
    z-index: 4;
    display: block;
    width: 7px;
    height: 7px;
    pointer-events: none;
  }

  .section-corner--top {
    inset-block-start: -4px;
  }

  .section-corner--bottom {
    inset-block-end: -4px;
  }

  .section-corner--start {
    inset-inline-start: -4px;
  }

  .section-corner--end {
    inset-inline-end: -4px;
  }
</style>
