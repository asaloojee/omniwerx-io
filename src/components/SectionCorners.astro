---
interface Props {
  position?: "top" | "bottom";
}

const { position = "bottom" } = Astro.props;
---

<svg
  class:list={[
    "section-corner",
    "section-corner--start",
    `section-corner--${position}`,
  ]}
  width="9"
  height="9"
  viewBox="0 0 9 9"
  aria-hidden="true"
>
  <rect
    x="0.5"
    y="0.5"
    width="8"
    height="8"
    rx="1.8"
    fill="var(--black--primary)"
    stroke="var(--border-color--08)"
    stroke-width="1"></rect>
</svg>
<svg
  class:list={[
    "section-corner",
    "section-corner--end",
    `section-corner--${position}`,
  ]}
  width="9"
  height="9"
  viewBox="0 0 9 9"
  aria-hidden="true"
>
  <rect
    x="0.5"
    y="0.5"
    width="8"
    height="8"
    rx="1.8"
    fill="var(--black--primary)"
    stroke="var(--border-color--08)"
    stroke-width="1"></rect>
</svg>

<style>
  .section-corner {
    position: absolute;
    z-index: 4;
    display: block;
    width: 9px;
    height: 9px;
    pointer-events: none;
  }

  .section-corner--top {
    inset-block-start: -5px;
  }

  .section-corner--bottom {
    inset-block-end: -5px;
  }

  .section-corner--start {
    inset-inline-start: -4px;
  }

  .section-corner--end {
    inset-inline-end: -4px;
  }
</style>
