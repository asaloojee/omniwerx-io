---
// Simplified navigation for survey page - logo only, centered
---

<div class="navbar-framework">
  <div class="navbar-framework-gutter"></div>
  <div class="navbar-framework-wrapper"></div>
  <div class="navbar-framework-gutter"></div>
</div>
<nav class="section navbar" id="navbar" role="navigation" aria-label="Survey navigation">
  <div class="section-gutter"></div>
  <div class="section-wrapper">
    <div class="section-dot section-dot--left section-dot--top"></div>
    <div class="section-dot section-dot--right section-dot--top"></div>
    <div class="section-dot section-dot--left"></div>
    <div class="section-dot section-dot--right"></div>
    <div class="nav-wrapper survey-nav-wrapper">
      <a href="/" class="nav-logo">
        <img src="/hero-logo.png" alt="OMNIWERX Logo" loading="eager" />
      </a>
    </div>
  </div>
  <div class="section-gutter"></div>
</nav>

<style>
  .survey-nav-wrapper {
    padding: 0 32px;
    display: flex;
    justify-content: center;
    align-items: center;
    height: 100%;
  }
</style>
