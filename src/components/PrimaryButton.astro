---
import UpRightIcon from "../assets/icons/up-right.svg";

interface Props {
  href: string;
  fullWidth?: boolean;
}

const { href, fullWidth = false } = Astro.props;
---

<a
  class:list={["primary-button", { "primary-button--full": fullWidth }]}
  href={href}
>
  <span class="primary-button__label">
    <slot />
  </span>
  <span class="primary-button__icon" aria-hidden="true">
    <UpRightIcon />
  </span>
</a>

<style>
  .primary-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    justify-self: start;
    padding: 0.75rem 2rem;
    color: var(--background);
    background-color: var(--primary-red);
    background-image: repeating-linear-gradient(
      -45deg,
      color-mix(in srgb, var(--primary-red) 40%, transparent) 0 1px,
      transparent 1px 8px
    );
    border: 1px solid var(--primary-red);

    font-family: var(--font-mono);
    font-size: var(--text-body);
    font-weight: 600;
    line-height: var(--leading-1);
    letter-spacing: var(--tracking-vwide);
    text-transform: uppercase;
    text-decoration: none;
    transition:
      color 1600ms var(--bezier),
      background-color 1600ms var(--bezier);
  }

  .primary-button--full {
    width: 100%;
    box-sizing: border-box;
  }

  .primary-button__icon {
    display: flex;
    flex: none;
    transition: translate 1600ms var(--bezier);
  }

  .primary-button__icon svg {
    vertical-align: bottom;
  }

  .primary-button:hover {
    color: var(--primary-red);
    background-color: var(--background);
    transition:
      color 800ms var(--bezier),
      background-color 800ms var(--bezier);
  }

  .primary-button:hover .primary-button__icon {
    translate: 4px -4px;
    transition-duration: 800ms;
  }

  @media (prefers-reduced-motion: reduce) {
    .primary-button,
    .primary-button__icon {
      transition: none;
    }

    .primary-button:hover .primary-button__icon {
      translate: none;
    }
  }
</style>
