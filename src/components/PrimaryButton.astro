---
interface Props {
  href: string;
}

const { href } = Astro.props;
---

<a class="primary-button" href={href}>
  <span class="primary-button__label">
    <slot />
  </span>
  <span class="primary-button__icon ri-arrow-right-up-line" aria-hidden="true"
  ></span>
</a>

<style>
  .primary-button {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    justify-self: start;
    padding: 0.75rem 1.5rem 0.75rem 2rem;
    color: var(--primary-black);
    background-color: var(--primary-red);
    background-image: repeating-linear-gradient(
      -45deg,
      color-mix(in srgb, var(--primary-red) 40%, transparent) 0 1px,
      transparent 1px 8px
    );
    border: 1px solid var(--primary-red);

    font-family: var(--font-mono);
    font-size: var(--text-body);
    font-weight: 600;
    line-height: var(--leading-1);
    letter-spacing: var(--tracking-vwide);
    text-transform: uppercase;
    text-decoration: none;
    transition:
      color 1600ms var(--bezier),
      background-color 1600ms var(--bezier);
  }

  .primary-button__icon {
    flex: none;
    font-size: 1.5rem;
    line-height: 1;
  }

  .primary-button:hover {
    color: var(--primary-red);
    background-color: var(--primary-black);
    transition:
      color 800ms var(--bezier),
      background-color 800ms var(--bezier);
  }

  @media (prefers-reduced-motion: reduce) {
    .primary-button {
      transition: none;
    }
  }
</style>
