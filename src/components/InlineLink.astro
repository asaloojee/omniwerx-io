---
import arrowUpRight from "../assets/images/brand/arrow--up-right.svg";

interface Props {
  href: string;
  arrow?: boolean;
}

const { href, arrow = false } = Astro.props;
---

<a class="inline-link" href={href}>
  <span><slot /></span>
  {
    arrow && (
      <img
        class="inline-link__arrow"
        src={arrowUpRight.src}
        width="20"
        height="20"
        alt=""
        aria-hidden="true"
      />
    )
  }
</a>

<style>
  .inline-link {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding-block-end: 2px;
    color: inherit;
    font: inherit;
    font-weight: 500;
    line-height: var(--leading-1);
    letter-spacing: inherit;
    text-decoration: none;
    box-shadow: 0 1px 0 var(--inline-link-underline, var(--primary-red));
    transition: box-shadow 800ms var(--bezier);
  }

  .inline-link__arrow {
    inline-size: 0.875em;
    block-size: 0.875em;
    flex: none;
  }

  .inline-link:hover {
    box-shadow: 0 1px 0 transparent;
  }

  @media (prefers-reduced-motion: reduce) {
    .inline-link {
      transition: none;
    }
  }
</style>
