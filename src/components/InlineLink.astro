---
interface Props {
  href: string;
}

const { href } = Astro.props;
---

<a class="inline-link" href={href}>
  <span class="inline-link__text"><slot /></span>
</a>

<style>
  .inline-link {
    color: var(--white--primary);
    font-size: inherit;
    line-height: inherit;
    letter-spacing: inherit;
    font-weight: 400;
    text-decoration: none;
  }

  .inline-link__text {
    display: inline-block;
    line-height: var(--leading-1);
    box-shadow: inset 0 -1px 0 var(--primary-red);
    transition: box-shadow 800ms var(--bezier);
    padding-block-end: 2px;
  }

  .inline-link:hover .inline-link__text {
    box-shadow: inset 0 -1px 0 transparent;
  }

  @media (prefers-reduced-motion: reduce) {
    .inline-link__text {
      transition: none;
    }
  }
</style>
