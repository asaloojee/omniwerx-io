---
// Terminal divider with typing animation easter egg
---

<section class="section divider terminal-divider">
  <div class="section-gutter"></div>
  <div class="section-wrapper divider-wrapper">
    <div class="section-dot section-dot--left section-dot--top"></div>
    <div class="section-dot section-dot--right section-dot--top"></div>
    <div class="section-dot section-dot--left"></div>
    <div class="section-dot section-dot--right"></div>
    <div class="divider-content">
      <div class="terminal-content">
        <span class="terminal-prompt">$</span>
        <span class="terminal-command"></span>
        <span class="terminal-cursor">|</span>
      </div>
    </div>
  </div>
  <div class="section-gutter"></div>
</section>

<style>
  .divider .section-gutter {
    border-top: 1px dashed var(--section-gutter--border);
    border-bottom: 1px dashed var(--section-gutter--border);
  }

  .divider .divider-wrapper {
    padding: 0;
    border-top: 1px solid var(--section-wrapper--border);
    border-bottom: 1px solid var(--section-wrapper--border);
    border-left: 1px dashed var(--section-gutter--border);
    border-right: 1px dashed var(--section-gutter--border);
  }

  .divider-content {
    height: 32px;
    background-color: var(--primary-black);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .terminal-content {
    display: flex;
    gap: 8px;
    align-items: center;
    font-family: "JetBrains Mono", monospace;
    font-size: 14px;
    font-weight: 400;
    line-height: 1;
  }

  .terminal-prompt {
    color: rgba(0, 255, 100, 0.8);
    opacity: 0.9;
  }

  .terminal-command {
    color: rgba(0, 255, 100, 0.7);
    opacity: 0.9;
    letter-spacing: 0.02em;
  }

  .terminal-cursor {
    color: rgba(0, 255, 100, 0.8);
    opacity: 0.9;
    animation: blink 1s step-end infinite;
  }

  @keyframes blink {
    0%, 50% {
      opacity: 0.9;
    }
    50.1%, 100% {
      opacity: 0;
    }
  }
</style>

<script>
  const text = "npx omniwerx";
  const commandElement = document.querySelector('.terminal-command');
  let index = 0;
  let isDeleting = false;

  function typeAnimation() {
    if (!commandElement) return;

    if (!isDeleting) {
      // Typing phase
      index++;
      commandElement.textContent = text.substring(0, index);

      if (index > text.length) {
        // Finished typing - pause before deleting (longer pause)
        isDeleting = true;
        setTimeout(typeAnimation, 3000);
        return;
      }

      // Continue typing
      setTimeout(typeAnimation, 100);
    } else {
      // Deleting phase
      index--;
      commandElement.textContent = text.substring(0, index);

      if (index === 0) {
        // Finished deleting - pause before typing again
        isDeleting = false;
        setTimeout(typeAnimation, 1000);
        return;
      }

      // Continue deleting (faster than typing)
      setTimeout(typeAnimation, 50);
    }
  }

  // Start animation when page loads
  document.addEventListener('DOMContentLoaded', () => {
    setTimeout(typeAnimation, 500);
  });
</script>
