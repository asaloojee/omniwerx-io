---
interface Props {
  size: number;
}

const { size } = Astro.props;
const normalizedSize = Number.isFinite(size) ? Math.max(0, size) : 0;
---

<div
  class="spacer"
  style={`--spacer-size: ${normalizedSize}rem`}
  aria-hidden="true"
>
  <div class="grid-column-left"></div>
  <div class="grid-column-center"></div>
  <div class="grid-column-right"></div>
</div>

<style>
  .spacer {
    --grid-inner-rule: var(--rule--secondary);

    height: var(--spacer-size);
  }

  @media (min-width: 992px) {
    .spacer {
      display: grid;
      grid-template-columns: subgrid;
    }
  }
</style>
