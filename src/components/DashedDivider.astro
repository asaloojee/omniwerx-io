---
import SectionCorners from "./SectionCorners.astro";

interface Props {
  orientation?: "horizontal" | "vertical";
}

const { orientation = "horizontal" } = Astro.props;
---

<div
  class:list={["dashed-divider", `dashed-divider--${orientation}`]}
  aria-hidden="true"
>
  <div class="dashed-divider__center">
    <SectionCorners position="bottom" />
  </div>
</div>

<style>
  .dashed-divider {
    display: grid;
    grid-column: 1 / -1;
    grid-template: minmax(0, 1fr) / var(--section-columns);
    width: 100%;
    height: 1rem;
    border-block: var(--rule-structural);
  }

  .dashed-divider__center {
    position: relative;
    grid-column: 2;
    height: 100%;
    min-width: 0;
    border-inline: var(--rule-structural);
  }

  .dashed-divider__center,
  .dashed-divider--vertical {
    background-image: repeating-linear-gradient(
      -45deg,
      transparent 0 7px,
      rgba(51, 50, 50, 0.8) 7px 8px
    );
  }

  .dashed-divider--vertical {
    display: block;
    grid-column: auto;
    width: 1rem;
    height: 100%;
    border-block: 0;
    border-inline: var(--rule-structural);
  }

  .dashed-divider--vertical .dashed-divider__center {
    display: none;
  }
</style>
