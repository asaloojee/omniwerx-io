---
import SectionCorners from "./SectionCorners.astro";
---

<nav class="nav" aria-hidden="true">
  <div class="nav__row-1">
    <SectionCorners position="bottom" />
    <a href="/" class="nav__img-link">
      <img src="/wordmark.svg" alt="" class="nav__img" />
    </a>
    <div class="nav__links">
      <a href="#work" class="nav__link">Work</a>
      <a href="#pricing" class="nav__link">Pricing</a>
      <a href="#contact" class="nav__link">Contact</a>
    </div>
  </div>
  <div class="nav__row-2"></div>
  <div class="nav__row-3">
    <div class="section-content"></div>
    <SectionCorners position="top" />
  </div>
</nav>

<style>
  .nav {
    /* margin-block-start: 0.5rem; */
    grid-column: full-start / full-end;

    display: grid;
    grid-template-columns: subgrid;
    grid-template-rows: 4rem var(--divider-hatched) var(--divider-empty);
    /* border-block: var(--rule-secondary); */
    border-block-end: var(--rule-secondary);
  }

  .nav__row-1,
  .nav__row-3 {
    grid-column: structure-start / structure-end;
    display: grid;
    grid-template-columns: subgrid;
    position: relative;
  }

  .nav__row-1 {
    position: relative;
    padding: 1rem;
    background-color: var(--surface);
    display: flex;
    justify-content: space-between;
    border-inline: var(--rule-structural);
  }

  /* .nav__row-1::before { */
  /*   position: absolute; */
  /*   content: ""; */
  /*   width: calc(100% + 2px); */
  /*   height: 1rem; */
  /*   border-inline: var(--rule-structural); */
  /*   top: -1rem; */
  /*   left: -1px; */
  /* } */

  .nav__img-link {
    padding-block-end: 4px;
  }

  .nav__img {
    height: 1.5rem;
  }

  .nav__links {
    display: flex;
    flex-direction: row;
    gap: 2rem;
    align-items: center;
  }

  .nav__link {
    font-family: var(--font-mono);
    font-weight: 400;
    font-size: var(--text-body);
    text-transform: uppercase;
    letter-spacing: var(--tracking-vwide);
    line-height: var(--leading-1);
    color: var(--body-text);
    text-decoration: none;
  }

  .nav__link:hover {
    cursor: pointer;
    color: var(--body-text--emphasis);
  }

  .nav__row-2 {
    grid-row: 2;
    grid-column: full-start / full-end;
    border-block: var(--rule-structural);
    background: repeating-linear-gradient(
      -45deg,
      var(--border-color--hatched) 0 1px,
      transparent 1px 8px
    );
  }

  .nav__row-3 {
    grid-row: 3;
    border-inline: var(--rule-structural);
  }
</style>
