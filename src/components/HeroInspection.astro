---
import SectionCorners from "./SectionCorners.astro";
---

<div class="type-inspection" data-type-inspection>
  <h1>
    <button
      class="type-inspection__trigger"
      type="button"
      aria-expanded="false"
      aria-controls="hero-type-pane"
      aria-label="Inspect headline typography"
    >
      Precision
    </button>-engineered websites &amp; interfaces.
  </h1>

  <div class="type-inspection__frame" aria-hidden="true">
    <SectionCorners position="top" />
    <SectionCorners position="bottom" />
  </div>

  <aside
    class="type-inspection__pane"
    id="hero-type-pane"
    aria-label="Headline typography"
    aria-hidden="true"
  >
    <header class="type-inspection__pane-header">
      <span>Typography</span>
      <span>Value</span>
    </header>
    <dl class="type-inspection__properties">
      <div>
        <dt>Typeface</dt>
        <dd>Söhne</dd>
      </div>
      <div>
        <dt>Weight</dt>
        <dd>700</dd>
      </div>
      <div>
        <dt>Size</dt>
        <dd>64px</dd>
      </div>
      <div>
        <dt>Line height</dt>
        <dd>1</dd>
      </div>
      <div>
        <dt>Tracking</dt>
        <dd>−0.01em</dd>
      </div>
      <div>
        <dt>Color</dt>
        <dd class="type-inspection__color">
          <span aria-hidden="true"></span>#F5F2F3
        </dd>
      </div>
    </dl>
  </aside>
</div>

<script>
  document
    .querySelectorAll<HTMLElement>("[data-type-inspection]")
    .forEach((inspection) => {
      const trigger = inspection.querySelector("button");
      const pane = inspection.querySelector(
        "[aria-label='Headline typography']",
      );

      if (
        !(trigger instanceof HTMLButtonElement) ||
        !(pane instanceof HTMLElement)
      ) {
        return;
      }

      const setOpen = (open: boolean) => {
        inspection.toggleAttribute("data-open", open);
        trigger.setAttribute("aria-expanded", String(open));
        trigger.setAttribute(
          "aria-label",
          open ? "Close headline typography" : "Inspect headline typography",
        );
        pane.setAttribute("aria-hidden", String(!open));
      };

      trigger.addEventListener("click", () => {
        setOpen(!inspection.hasAttribute("data-open"));
      });

      document.addEventListener("click", (event) => {
        if (
          inspection.hasAttribute("data-open") &&
          event.target instanceof Node &&
          !inspection.contains(event.target)
        ) {
          setOpen(false);
        }
      });

      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && inspection.hasAttribute("data-open")) {
          setOpen(false);
          trigger.focus();
        }
      });
    });
</script>

<style>
  .type-inspection {
    position: relative;
    grid-row: 2;
    isolation: isolate;
  }

  .type-inspection__trigger {
    --border-color--08: var(--primary-red);

    position: relative;
    appearance: none;
    padding: 0 0 0.05em;
    border: 0;
    background: transparent;
    color: inherit;
    font: inherit;
    letter-spacing: inherit;
    line-height: inherit;
    box-shadow: inset 0 -1px 0 var(--primary-red);
    cursor: pointer;
    transition: box-shadow 800ms var(--bezier);
  }

  .type-inspection__trigger:is(:hover, :focus-visible),
  .type-inspection[data-open] .type-inspection__trigger {
    box-shadow: inset 0 -1px 0 transparent;
    outline: none;
  }

  .type-inspection__frame {
    --inspection-corner-color: var(--primary-red);

    position: absolute;
    z-index: -1;
    inset: -0.75rem -1rem;
    border: 1px solid transparent;
    opacity: 0;
    pointer-events: none;
    transition: opacity 120ms var(--bezier);
  }

  .type-inspection__frame :global(.section-corner rect) {
    stroke: var(--inspection-corner-color);
  }

  .type-inspection__frame :global(.section-corner--start) {
    inset-inline-start: -5px;
  }

  .type-inspection__frame :global(.section-corner--end) {
    inset-inline-end: -5px;
  }

  .type-inspection:has(
      .type-inspection__trigger:is(:hover, :focus-visible)
    ):not([data-open])
    .type-inspection__frame {
    opacity: 1;
  }

  .type-inspection__pane {
    position: absolute;
    z-index: 3;
    inset-inline-end: 0;
    inset-block-end: calc(100% + 2rem);
    inline-size: min(100%, 20rem);
    border-block: var(--rule--secondary);
    background: var(--black--primary);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition-property: opacity, visibility;
    transition-duration: 160ms;
    transition-timing-function: var(--bezier);
  }

  .type-inspection__pane-header,
  .type-inspection__properties > div {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 1rem;
    min-block-size: 2rem;
    padding-inline: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 400;
    line-height: var(--leading-1);
  }

  .type-inspection__pane-header {
    color: var(--white--tertiary-06);
    letter-spacing: var(--tracking-vwide);
    text-transform: uppercase;
  }

  .type-inspection__properties > div {
    border-block-start: var(--rule--secondary);
  }

  .type-inspection__properties dt {
    color: var(--white--tertiary);
  }

  .type-inspection__properties dd {
    color: var(--white--primary);
    letter-spacing: var(--tracking-wide);
  }

  .type-inspection__color {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .type-inspection__color span {
    inline-size: 0.625rem;
    block-size: 0.625rem;
    background: var(--white--primary);
    box-shadow: 0 0 0 1px var(--border-color--08);
  }

  .type-inspection[data-open] .type-inspection__frame {
    --inspection-corner-color: rgb(82 81 81);

    border-color: rgb(82 81 81);
    background: var(--black--secondary);
    opacity: 1;
  }

  .type-inspection[data-open] .type-inspection__pane {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  @media (prefers-reduced-motion: reduce) {
    .type-inspection__trigger,
    .type-inspection__frame,
    .type-inspection__pane {
      transition-duration: 0s;
    }
  }
</style>
