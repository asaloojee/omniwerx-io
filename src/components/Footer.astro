---
import InlineLink from "./InlineLink.astro";
import { getGitCommitHash } from "../scripts/git-commit.js";

const { utilityOnly = false } = Astro.props;
const commitHash = getGitCommitHash();
---

<footer class="footer">
  {
    !utilityOnly && (
      <>
        <div class="meta-row">
          omnx_07::<em>contact</em>
        </div>
        <div class="footer__contact">
          <div class="footer__invitation">
            <h2>Have a project in mind?</h2>
            <p class="footer__invitation-link">
              <InlineLink href="mailto:asaloojee@omniwerx.io" arrow>
                Let’s talk.
              </InlineLink>
            </p>
          </div>
          <nav class="footer__links" aria-label="Social links">
            <a
              href="https://www.github.com/asaloojee"
              target="_blank"
              rel="noopener noreferrer"
            >
              <span>GitHub</span>
            </a>
            <a
              href="https://www.instagram.com/saloojee_a"
              target="_blank"
              rel="noopener noreferrer"
            >
              <span>Instagram</span>
            </a>
            <a
              href="https://www.linkedin.com/in/abdurahmaan-saloojee"
              target="_blank"
              rel="noopener noreferrer"
            >
              <span>LinkedIn</span>
            </a>
            <a
              href="https://www.x.com/saloojee_a"
              target="_blank"
              rel="noopener noreferrer"
            >
              <span>X</span>
            </a>
          </nav>
        </div>
      </>
    )
  }
  <div class="footer__utility">
    <p class="footer__copyright">
      &copy; 2026 Omniwerx&reg;. All rights reserved.
    </p>
    <p>
      // build:&nbsp;
      <a
        href="https://github.com/asaloojee/omniwerx-io"
        title="Git commit"
        target="_blank"
        rel="noopener noreferrer"
      >
        <code>{commitHash}</code>
      </a>
    </p>
  </div>
</footer>

<style>
  footer {
    display: grid;
    grid-template-columns: calc(100cqw - 2rem);
    justify-self: center;
    border-inline: var(--rule-vertical);
    box-shadow:
      inset 1px 0 0 var(--border-color--shadow),
      inset -1px 0 0 var(--border-color--shadow);
  }

  footer a {
    color: inherit;
    text-decoration: none;
  }

  .footer__contact {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 1fr);
    border-block-end: var(--rule-primary);
  }

  .footer__invitation {
    padding: 4rem 1rem 4rem;
    border-inline-end: var(--rule-vertical);
    box-shadow: var(--rule-vertical-shadow);
  }

  .footer__invitation h2 {
    padding: 0;
    font-size: var(--text-heading);
    font-weight: 700;
    line-height: var(--leading-1);
    letter-spacing: var(--tracking-vtight);
    text-wrap: balance;
  }

  .footer__invitation-link {
    margin-block-start: 1rem;
    color: var(--white--primary);
    font-size: var(--text-title);
  }

  .footer__links {
    display: grid;
    grid-template-rows: repeat(4, minmax(2.5rem, 1fr));
  }

  .footer__links a {
    display: grid;
    place-items: center;
    color: var(--white--primary);
    font-family: var(--font-mono);
    line-height: var(--leading-1);
  }

  .footer__links a:not(:last-child) {
    border-block-end: var(--rule-primary);
  }

  .footer__links span {
    padding-block-end: 2px;
    box-shadow: 0 1px 0 var(--white--primary);
    transition: box-shadow 800ms var(--bezier);
  }

  .footer__links a:hover span {
    box-shadow: 0 1px 0 transparent;
  }

  .footer__utility {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    padding: 1rem;
    color: var(--white--tertiary);
    font-family: var(--font-mono);
    font-size: var(--text-small);
    line-height: var(--leading-mid);
  }

  .footer__copyright {
    color: var(--white--secondary);
  }

  .footer__utility a {
    transition: color 800ms var(--bezier);
  }

  .footer__utility a:hover {
    color: var(--white--primary);
  }

  @media (prefers-reduced-motion: reduce) {
    .footer__links span,
    .footer__utility a {
      transition: none;
    }
  }
</style>
