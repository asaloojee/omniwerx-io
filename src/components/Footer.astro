---
import InlineLink from "./InlineLink.astro";
import { getGitCommitHash } from "../scripts/git-commit.js";

const { utilityOnly = false } = Astro.props;
const commitHash = getGitCommitHash();
---

<footer class="footer">
  {
    !utilityOnly && (
      <>
        <div class="meta-row">
          omnx_07::<em>contact</em>
        </div>
        <div class="footer__contact">
          <div class="footer__email">
            <InlineLink href="mailto:info@omniwerx.io" arrow>
              info@omniwerx.io
            </InlineLink>
          </div>
          <nav class="footer__links" aria-label="Social links">
            <a
              href="https://www.github.com/asaloojee"
              target="_blank"
              rel="noopener noreferrer"
            >
              <span>GitHub</span>
            </a>
            <a
              href="https://www.instagram.com/saloojee_a"
              target="_blank"
              rel="noopener noreferrer"
            >
              <span>Instagram</span>
            </a>
            <a
              href="https://www.linkedin.com/in/abdurahmaan-saloojee"
              target="_blank"
              rel="noopener noreferrer"
            >
              <span>LinkedIn</span>
            </a>
            <a
              href="https://www.x.com/saloojee_a"
              target="_blank"
              rel="noopener noreferrer"
            >
              <span>X</span>
            </a>
          </nav>
        </div>
      </>
    )
  }
  <div class="footer__utility">
    <p class="footer__copyright">
      &copy; 2026 Omniwerx&reg;. All rights reserved.
    </p>
    <p>
      // build:&nbsp;
      <a
        href="https://github.com/asaloojee/omniwerx-io"
        title="Git commit"
        target="_blank"
        rel="noopener noreferrer"
      >
        <code>{commitHash}</code>
      </a>
    </p>
  </div>
</footer>

<style>
  footer {
    display: grid;
    grid-template-columns: calc(100cqw - 2rem);
    justify-self: center;
    border-block-end: var(--rule-emphasis);
    border-inline: var(--rule-vertical);
    box-shadow:
      inset 1px 0 0 var(--border-color--shadow),
      inset -1px 0 0 var(--border-color--shadow);
  }

  footer a {
    color: inherit;
    text-decoration: none;
  }

  .footer__contact {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-block-size: 2.5rem;
    border-block-end: var(--rule-primary);
  }

  .footer__email {
    display: flex;
    align-items: center;
    padding-inline-start: 1rem;
    font-size: 1.25rem;
  }

  .footer__links {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding-inline-end: 1rem;
  }

  .footer__links a {
    display: grid;
    place-items: center;
    min-inline-size: 2.5rem;
    min-block-size: 2.5rem;
    color: var(--white--primary);
    font-family: var(--font-mono);
    line-height: var(--leading-1);
  }

  .footer__utility {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    padding: 1rem;
    color: var(--white--tertiary);
    font-family: var(--font-mono);
    font-size: var(--text-small);
    line-height: var(--leading-mid);
  }

  .footer__copyright {
    color: var(--white--secondary);
  }

  .footer__utility a {
    transition: color 800ms var(--bezier);
  }

  .footer__utility a:hover {
    color: var(--white--primary);
  }

  @media (prefers-reduced-motion: reduce) {
    .footer__utility a {
      transition: none;
    }
  }
</style>
