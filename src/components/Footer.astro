---
import { getGitCommitHash } from "../scripts/git-commit.js";

const commitHash = getGitCommitHash();
---

<footer class="footer">
  <div class="footer__content">
    <div class="meta-row footer__socials-heading">
      omnx_07::<em>socials</em>
    </div>
    <div class="meta-row">omnx_08::<em>copyright</em></div>

    <div class="footer__links">
      <a href="https://www.github.com/asaloojee" class="footer__link"
        ><span>Github</span></a
      >
      <a href="https://www.instagram.com/saloojee_a" class="footer__link"
        ><span>Instagram</span></a
      >
      <a href="https://www.linkedin.com/asaloojee" class="footer__link"
        ><span>LinkedIn</span></a
      >
      <a href="https://www.x.com/saloojee_a" class="footer__link"
        ><span>X</span></a
      >
    </div>
    <div class="footer__copyright__text">
      <p>&copy Omniwerx&reg; 2026. All rights reserved.</p>
      <p>
        Build:&nbsp;
        <a
          class="footer__repo-button"
          href="https://github.com/asaloojee/omniwerx-io"
          target="_blank"
          rel="noreferrer"
        >
          <code title="Git commit">{commitHash}</code>
        </a>
      </p>
    </div>
  </div>
</footer>

<style>
  footer {
    display: grid;
    grid-template-columns: calc(100cqw - 2rem);
    justify-self: center;
    border-inline: var(--rule-vertical);
    box-shadow:
      inset 1px 0 0 var(--border-color--shadow),
      inset -1px 0 0 var(--border-color--shadow);
  }

  footer a {
    text-decoration: none;
    color: var(--white--primary);
    line-height: var(--leading-1);
  }

  .footer__content {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-template-rows: auto minmax(2.5rem, auto);
  }

  .footer__socials-heading,
  .footer__links {
    border-inline-end: var(--rule-vertical);
    box-shadow: var(--rule-vertical-shadow);
  }

  .footer__links {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
  }

  .footer__link {
    font-family: var(--font-mono);
    display: grid;
    place-items: center;
  }

  .footer__link span {
    padding-block-end: 2px;
    box-shadow: 0 1px 0 var(--white--primary);
    transition: box-shadow 800ms var(--bezier);
  }

  .footer__link:hover span {
    box-shadow: 0 1px 0 transparent;
  }

  .footer__link:not(:last-child) {
    border-inline-end: var(--rule-primary);
  }

  .footer__copyright__text {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding-inline: 1rem;
    padding-block: 0.5rem;
    color: var(--white--tertiary);
  }

  .footer__repo-button {
    font-family: var(--font-mono);
  }

  @media (prefers-reduced-motion: reduce) {
    .footer__link span {
      transition: none;
    }
  }
</style>
