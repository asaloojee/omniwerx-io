---
import wordmark from "../assets/images/brand/wordmark-ghost.png";
import ArrowUp from "./ArrowUp.astro";
import { getGitCommitHash } from "../scripts/git-commit.js";

const commitHash = getGitCommitHash();
---

<footer class="site-footer">
  <div class="site-footer__meta-wrapper">
    <div class="site-footer__meta">
      <p class="site-footer__meta-row">
        <span>&copy; 2026&nbsp;&nbsp;OMNIWERX INC.</span>
        <a
          class="site-footer__repo-button"
          href="https://github.com/asaloojee/omniwerx-io"
          target="_blank"
          rel="noreferrer"
        >
          &#123; build:&nbsp;<span class="site-footer__repo-value"
            >&quot;<code title="Git commit">{commitHash}</code>&quot;
          </span>&nbsp;&#125;
        </a>
        <a href="#top">
          Back to top
          <ArrowUp class="site-footer__back-icon" />
        </a>
      </p>
    </div>
  </div>
  <div
    class="site-footer__wordmark"
    style={`--wordmark: url("${wordmark.src}")`}
    aria-hidden="true"
  >
  </div>
</footer>

<style>
  .site-footer {
    display: grid;
    justify-items: center;
  }

  .site-footer__meta-wrapper {
    display: grid;
    justify-items: center;
    width: 100%;
    border-block-end: var(--rule--secondary);
  }

  .site-footer__meta {
    width: min(100%, 48rem);
    padding: 1rem;
    color: var(--white--secondary);
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    line-height: var(--leading-mid);
    font-weight: 400;
  }

  .site-footer__meta-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .site-footer__meta-row > :last-child {
    justify-self: end;
  }

  .site-footer__meta code {
    color: inherit;
    font-family: inherit;
  }

  .site-footer__meta a {
    display: inline-flex;
    align-items: center;
    min-block-size: 2.5rem;
    gap: 0.375rem;
    color: inherit;
    text-decoration: none;
  }

  .site-footer__meta-row > :not(:first-child) {
    color: var(--white--tertiary);
  }

  .site-footer__meta .site-footer__repo-button {
    gap: 0;
    justify-self: center;
  }

  .site-footer__meta-row > a:not(.site-footer__repo-button):hover {
    color: var(--white--primary);
  }

  .site-footer__meta .site-footer__repo-button:hover {
    color: var(--white--tertiary);
  }

  .site-footer__repo-button:hover .site-footer__repo-value {
    color: var(--white--primary);
  }

  :global(.site-footer__back-icon) {
    width: 1rem;
    height: 1rem;
    flex: none;
  }

  .site-footer__meta a:focus-visible {
    outline: 1px solid oklch(0.964 0.003 27.557 / 0.45);
    outline-offset: 2px;
  }

  .site-footer__wordmark {
    width: 96cqw;
    aspect-ratio: 4580 / 592;
    margin-block-start: 1rem;
    margin-block-end: 0.5rem;
    background: var(--wordmark) center / contain no-repeat;
  }

  @media screen and (max-width: 768px) {
    .site-footer__meta-row {
      grid-template-columns: auto auto;
    }

    .site-footer__meta-row > :first-child {
      grid-column: 1 / -1;
      grid-row: 2;
      justify-self: center;
    }

    .site-footer__meta .site-footer__repo-button {
      justify-self: start;
    }
  }
</style>
