---
import { getGitCommitHash } from "../scripts/git-commit.js";

const commitHash = getGitCommitHash();
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__meta">
      <p class="site-footer__meta-row">
        <span>&copy; 2026</span>
        <a href="#top">to top</a>
      </p>
      <p class="site-footer__meta-row">
        <span>omniwerx&trade;</span>
        <code title="Git commit">{commitHash}</code>
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    display: grid;
    grid-template-columns: min(100%, 48rem);
    justify-content: center;
    padding-inline: var(--page-gutter);
  }

  .site-footer__inner {
    padding-inline: 1rem;
  }

  .site-footer__meta {
    padding: 1rem;
    border-block-start: var(--rule--secondary);
    color: var(--white--tertiary);
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    line-height: var(--leading-mid);
  }

  .site-footer__meta-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) max-content;
    gap: 1rem;
  }

  .site-footer__meta-row > :last-child {
    justify-self: end;
  }

  .site-footer__meta code {
    color: inherit;
    font-family: inherit;
  }

  .site-footer__meta a {
    color: inherit;
    text-decoration: none;
  }

  .site-footer__meta a:hover {
    color: var(--white--primary);
  }

  .site-footer__meta a:focus-visible {
    outline: 1px solid oklch(0.964 0.003 27.557 / 0.45);
    outline-offset: 2px;
  }
</style>
