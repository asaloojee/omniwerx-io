---
import { getGitCommitHash } from "../scripts/git-commit.js";

const commitHash = getGitCommitHash();
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__meta">
      <p>&copy; 2026 omniwerx&trade;</p>
      <code title="Git commit">{commitHash}</code>
      <a href="#top">To top</a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    display: grid;
    grid-template-columns: min(100%, 48rem);
    justify-content: center;
    padding-inline: var(--page-gutter);
  }

  .site-footer__inner {
    padding-inline: 1rem;
  }

  .site-footer__meta {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    padding-block: 1rem;
    border-block-start: var(--rule--secondary);
    color: var(--white--tertiary);
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    line-height: var(--leading-mid);
    padding-inline: 1rem;
  }

  .site-footer__meta code {
    color: inherit;
    font-family: inherit;
  }

  .site-footer__meta a {
    justify-self: end;
    color: inherit;
    text-decoration: none;
  }

  .site-footer__meta a:hover {
    color: var(--white--primary);
  }

  .site-footer__meta a:focus-visible {
    outline: 1px solid oklch(0.964 0.003 27.557 / 0.45);
    outline-offset: 2px;
  }
</style>
