---
import wordmark from "../assets/images/brand/wordmark.svg";
import { getGitCommitHash } from "../scripts/git-commit.js";

const commitHash = getGitCommitHash();
---

<footer class="site-footer">
  <div class="site-footer__meta">
    <p class="site-footer__meta-row">
      <span>&copy; 2026 omniwerx&trade;</span>
      <a href="#top">
        Back to top
        <svg
          class="site-footer__back-icon"
          viewBox="0 0 16 16"
          width="16"
          height="16"
          fill="none"
          aria-hidden="true"
        >
          <path
            d="M4 6 8 2l4 4M8 2v12"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"
            vector-effect="non-scaling-stroke"></path>
        </svg>
      </a>
    </p>
    <p class="site-footer__meta-row">
      <span>Independent Technical Studio</span>
      <span>Build <code title="Git commit">{commitHash}</code></span>
    </p>
  </div>
  <div
    class="site-footer__wordmark"
    style={`--wordmark: url("${wordmark.src}")`}
    aria-hidden="true"
  >
  </div>
</footer>

<style>
  .site-footer {
    display: grid;
    justify-items: center;
  }

  .site-footer__meta {
    width: min(calc(100% - (2 * var(--page-gutter))), 48rem);
    padding: 1rem;
    border-block-end: var(--rule--secondary);
    color: var(--white--tertiary);
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    line-height: var(--leading-mid);
    font-weight: 400;
  }

  .site-footer__meta-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) max-content;
    align-items: center;
    gap: 1rem;
  }

  .site-footer__meta-row > :last-child {
    justify-self: end;
  }

  .site-footer__meta code {
    color: inherit;
    font-family: inherit;
  }

  .site-footer__meta a {
    display: inline-flex;
    align-items: center;
    min-block-size: 2.5rem;
    gap: 0.375rem;
    color: inherit;
    text-decoration: none;
  }

  .site-footer__back-icon {
    width: 1rem;
    height: 1rem;
    flex: none;
  }

  .site-footer__meta a:hover {
    color: var(--white--primary);
  }

  .site-footer__meta a:focus-visible {
    outline: 1px solid oklch(0.964 0.003 27.557 / 0.45);
    outline-offset: 2px;
  }

  .site-footer__wordmark {
    width: 95cqw;
    aspect-ratio: 1047 / 146;
    margin-block-start: 1rem;
    margin-block-end: 0.5rem;
    background-color: var(--white--tertiary);
    mask: var(--wordmark) center / contain no-repeat;
  }
</style>
