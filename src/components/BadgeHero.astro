---
// No frontmatter logic needed for now
---

<div class="badge-stage">
  <model-viewer
    src="/logo-v2.glb"
    alt="Omniwerx logo"
    camera-controls
    disable-zoom
    disable-pan
    touch-action="pan-y"
    interaction-prompt="none"
    camera-orbit="110deg 15deg 1.2m"
    min-camera-orbit="auto auto 1.2m"
    max-camera-orbit="auto auto 1.2m"
    exposure="1.0"
    shadow-intensity="0.6"
    environment-image="neutral"
    loading="eager"
    orientation="0deg 90deg 0deg"
  ></model-viewer>
</div>

<style>
  .badge-stage {
    width: 100%;
    height: 560px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  model-viewer {
    width: 100%;
    height: 100%;
    background-color: transparent;
    --poster-color: transparent;
    transform: rotate(-90deg);
  }
</style>

<script>
  import '@google/model-viewer';
</script>
