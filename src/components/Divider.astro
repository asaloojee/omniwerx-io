---
import SectionCorners from "./SectionCorners.astro";
---

<div class="divider grid-viewport" aria-hidden="true">
  <div class="divider__content grid-full">
    <SectionCorners position="top" />
    <SectionCorners position="bottom" />
  </div>
</div>

<style>
  .divider {
    height: 2rem;
    border-block: var(--rule--primary);
    background-image: repeating-linear-gradient(
      -45deg,
      transparent 0 7px,
      var(--border-color--02) 7px 8px
    );
  }

  @media (min-width: 992px) {
    .divider {
      display: grid;
      grid-template-columns: subgrid;
    }

    .divider__content {
      position: relative;
    }
  }
</style>
