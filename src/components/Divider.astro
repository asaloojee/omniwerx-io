---
interface Props {
withLink?: boolean;
linkText?: string;
linkHref?: string;
first?: boolean;
}

const { withLink = false, linkText, linkHref, first = false } = Astro.props;
---

<section class={`section divider ${first ? 'divider--first' : ''}`}>
  <div class="section-gutter"></div>
  <div class="section-wrapper divider-wrapper">
    <div class="section-dot section-dot--left section-dot--top"></div>
    <div class="section-dot section-dot--right section-dot--top"></div>
    <div class="section-dot section-dot--left"></div>
    <div class="section-dot section-dot--right"></div>
    <div class="divider-content">
      {withLink && linkText && linkHref && (
      <a href={linkHref} class="divider-link">
        <span class="divider-link-text">{linkText}</span>
        <span class="divider-link-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="140" height="140" viewBox="0 0 140 140">
            <path id="arrow-path" d="M 0,140 L 100,40 M 20,40 L 100,40 L 100,120" fill="none" stroke="currentColor"
              stroke-width="24" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </span>
      </a>
      )}
    </div>
  </div>
  <div class="section-gutter"></div>
</section>

<style>
  .divider .section-gutter {
    border-top: 1px dashed var(--section-gutter--border);
    border-bottom: 1px dashed var(--section-gutter--border);
  }

  .divider .divider-wrapper {
    padding: 0;
    border-top: 1px solid var(--section-wrapper--border);
    border-bottom: 1px solid var(--section-wrapper--border);
    border-left: 1px dashed var(--section-gutter--border);
    border-right: 1px dashed var(--section-gutter--border);
    height: 32px;
  }

  /* First divider variant - overlap borders to prevent double-thickness */
  .divider--first {
    margin-top: -1px;
  }

  .divider-content {
    height: 100%;
    background-color: var(--primary-black);
    line-height: 1;
  }

  /* Link variant styles */
  .divider-link {
    display: flex;
    flex-direction: row;
    justify-content: center;
    gap: 8px;
    width: 100%;
    text-align: center;
    padding: 4px 16px;
    background-color: var(--divider-link-bg);
    transition: background-color 200ms ease-in-out;
    align-items: center;
    text-decoration: none;
  }

  .divider-link:hover {
    cursor: pointer;
    background-color: var(--divider-link-bg-hover);
  }

  .divider-link:hover #arrow-path {
    animation: arrow-bounce 0.4s ease-in-out;
  }

  @keyframes arrow-bounce {
    0% {
      d: path("M 0,140 L 100,40 M 20,40 L 100,40 L 100,120");
    }

    40% {
      d: path("M 0,140 L 140,0 M 60,5 L 140,0 L 135,80");
    }

    100% {
      d: path("M 0,140 L 100,40 M 20,40 L 100,40 L 100,120");
    }
  }

  .divider-link-text {
    color: var(--body-text--emphasis);
    opacity: 0.9;
    font-family: "JetBrains Mono", monospace;
    font-size: 14px;
    font-weight: 400;
    line-height: 30px;
    letter-spacing: 0.03em;
  }

  .divider-link-icon {
    height: 20px;
    width: 20px;
    margin-bottom: 4px;
  }

  .divider-link-icon svg {
    color: var(--body-text);
    opacity: 0.9;
    height: 100%;
    width: 100%;
  }
</style>
