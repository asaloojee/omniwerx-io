---
import SurveyNav from '../components/SurveyNav.astro';
import Divider from '../components/Divider.astro';
import Footer from '../components/Footer.astro';

// Check if survey is enabled at build time
const SURVEY_ENABLED = import.meta.env.SURVEY_ENABLED === true;

// Return 404 if survey disabled
if (!SURVEY_ENABLED) {
  return Astro.redirect('/404', 404);
}

// Check for auth cookie
const authCookie = Astro.cookies.get('survey_auth');
const isAuthenticated = authCookie && authCookie.value === 'authenticated';
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Survey - OMNIWERX</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="stylesheet" href="/global.css" />
</head>
<body class="survey-page">
  <main class="survey-main">
    <SurveyNav />
    <Divider first={true} />
    <section class="section survey-section">
      <div class="section-gutter"></div>
      <div class="section-wrapper">
        <div class="section-dot section-dot--left section-dot--top"></div>
        <div class="section-dot section-dot--right section-dot--top"></div>
        <div class="section-dot section-dot--left"></div>
        <div class="section-dot section-dot--right"></div>
        <div class="survey-content">
          {!isAuthenticated ? (
            <div id="passwordForm" class="survey-form">
              <div class="lock-container">
                <svg class="lock-icon" viewBox="-60 -35 220 155" xmlns="http://www.w3.org/2000/svg">
                  <!-- Lock shackle (upside-down U) -->
                  <path
                    class="lock-shackle"
                    d="M 14 46 L 14 22 C 14 10, 28 -9, 50 -9 C 72 -9, 86 10, 86 22 L 86 46"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="3"
                    stroke-linecap="round"
                  />
                  <!-- Lock body (flattened rectangle) -->
                  <rect
                    class="lock-body"
                    x="2"
                    y="46"
                    width="96"
                    height="72"
                    rx="8"
                    ry="8"
                    fill="transparent"
                    stroke="currentColor"
                    stroke-width="3"
                  />
                </svg>
              </div>
              <form id="authForm">
                <input type="password" name="password" placeholder="Password" required />
                <button type="submit">Access Survey</button>
              </form>
              <div id="authMessage" class="form-message"></div>
            </div>
          ) : (
            <div id="surveyForm" class="survey-form">
              <div id="userInfoStep">
                <h1 class="h2">Personal Trainer Survey</h1>
                <p class="body-text">Thank you for participating. Please provide your information to begin.</p>
                <form id="userInfoForm">
                  <input type="text" name="name" placeholder="Name" required />
                  <input type="email" name="email" placeholder="Email" required />
                  <button type="submit">Start Survey</button>
                </form>
                <div id="userInfoMessage" class="form-message"></div>
              </div>

              <div id="questionsStep" style="display: none;">
                <div class="question-header">
                  <div id="questionCounter" class="question-counter"></div>
                </div>
                <div id="questionContainer"></div>
                <div class="survey-navigation">
                  <button id="prevBtn" style="display: none;">Previous</button>
                  <button id="nextBtn">Next</button>
                  <button id="submitBtn" style="display: none;">Submit</button>
                </div>
              </div>

              <div id="successStep" style="display: none;">
                <h2 class="h2">Thank you!</h2>
                <p class="body-text">Your responses have been submitted successfully.</p>
              </div>
            </div>
          )}
        </div>
      </div>
      <div class="section-gutter"></div>
    </section>
    <Divider />
  </main>
  <Footer />
</body>
</html>

<style is:global>
  /* Sticky footer layout */
  .survey-page {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  .survey-main {
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .survey-section {
    flex: 1;
  }

  .survey-section .section-wrapper {
    padding: 96px 32px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 100%;
  }

  .survey-content {
    max-width: 544px;
    margin: 0 auto;
    width: 100%;
  }

  .lock-container {
    background-color: rgba(204, 0, 24, 0.2);
    border: 2px solid var(--primary-red);
    border-radius: 12px;
    padding: 24px;
    display: flex;
    justify-content: center;
    align-items: center;
    margin: 0 auto 32px;
    width: 240px;
    height: 240px;
  }

  .lock-icon {
    width: 200px;
    height: 141px;
    color: var(--primary-red);
    transition: color 900ms ease-in-out;
  }

  .lock-shackle {
    transform-origin: 14px 46px;
  }

  .lock-container {
    transition:
      background-color 900ms ease-in-out,
      border-color 900ms ease-in-out;
  }

  .lock-container.unlocking {
    background-color: rgba(0, 128, 0, 0.2);
    border-color: #00ff00;
  }

  .lock-container.unlocking .lock-icon {
    color: #00ff00;
  }

  .lock-container.unlocking .lock-shackle {
    animation:
      shackle-raise 400ms ease-in-out forwards,
      shackle-swing 400ms ease-in-out 500ms forwards;
  }

  .survey-form.fade-out {
    animation: fadeOut 400ms ease-in-out forwards;
  }

  @keyframes fadeOut {
    from {
      opacity: 1;
    }
    to {
      opacity: 0;
    }
  }

  @keyframes shackle-raise {
    from {
      d: path("M 14 46 L 14 22 C 14 10, 28 -9, 50 -9 C 72 -9, 86 10, 86 22 L 86 46");
    }
    to {
      d: path("M 14 46 L 14 2 C 14 -10, 28 -29, 50 -29 C 72 -29, 86 -10, 86 2 L 86 26");
    }
  }

  @keyframes shackle-swing {
    from {
      d: path("M 14 46 L 14 2 C 14 -10, 28 -29, 50 -29 C 72 -29, 86 -10, 86 2 L 86 26");
    }
    to {
      d: path("M 14 46 L 14 2 C 14 -10, 0 -29, -22 -29 C -44 -29, -58 -10, -58 2 L -58 26");
    }
  }

  .survey-form {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .survey-form h1,
  .survey-form h2 {
    text-align: center;
  }

  .survey-form .body-text {
    text-align: center;
  }

  .survey-form form {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .survey-form input,
  .survey-form textarea {
    background-color: var(--input-background);
    border: 1px solid var(--card-border);
    border-radius: 4px;
    padding: 12px;
    color: var(--body-text);
    font-family: 'JetBrains Mono', monospace;
    font-size: 16px;
    font-weight: 300;
    width: 100%;
  }

  .survey-form input:focus,
  .survey-form textarea:focus {
    outline: none;
    background-color: var(--input-background--focus);
  }

  /* .survey-form textarea { */
  /*   min-height: 120px; */
  /*   resize: vertical; */
  /* } */

  .survey-form button {
    background-color: var(--primary-red);
    color: var(--body-text--emphasis);
    border: none;
    border-radius: 8px;
    padding: 12px 24px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 16px;
    font-weight: 500;
    cursor: pointer;
    text-transform: uppercase;
    box-shadow:
      0 0 16px rgba(204, 0, 24, 0.5),
      0 0 20px rgba(204, 0, 24, 0.3);
  }

  .survey-form button:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .question-header {
    display: flex;
    justify-content: flex-end;
    margin-bottom: 32px;
  }

  .question-counter {
    font-family: 'JetBrains Mono', monospace;
    font-size: 14px;
    font-weight: 500;
    color: var(--secondary-red);
    background: rgba(224, 31, 55, 0.2);
    padding: 4px 12px;
    border-radius: 16px;
    border: 1px solid var(--secondary-red);
    letter-spacing: 0.05em;
  }

  .question-card {
    margin-bottom: 32px;
  }

  .question-text {
    font-size: 20px;
    font-weight: 400;
    color: var(--body-text--emphasis);
    margin-bottom: 16px;
  }

  .survey-navigation {
    display: flex;
    gap: 16px;
    justify-content: space-between;
  }

  .survey-navigation button {
    flex: 1;
  }

  /* Secondary navigation buttons (Previous/Next) */
  #prevBtn,
  #nextBtn {
    background-color: transparent;
    border: 1px solid var(--primary-red);
    color: var(--primary-red);
    box-shadow: none;
    transition: all 0.2s ease;
  }

  #prevBtn:hover,
  #nextBtn:hover {
    background-color: rgba(204, 0, 24, 0.1);
    border-color: var(--secondary-red);
  }

  /* Primary submit button keeps the filled style */
  #submitBtn {
    /* Inherits default .survey-form button styles */
  }

  .form-message {
    padding: 12px;
    border-radius: 8px;
    text-align: center;
    font-family: 'JetBrains Mono', monospace;
    font-size: 14px;
  }

  .form-message.error {
    background-color: rgba(204, 0, 24, 0.2);
    border: 1px solid var(--primary-red);
    color: var(--primary-red);
  }

  .form-message.success {
    background-color: rgba(0, 128, 0, 0.2);
    border: 1px solid #00ff00;
    color: #00ff00;
  }

  @media screen and (max-width: 768px) {
    .survey-section .section-wrapper {
      padding: 64px 16px;
    }
  }
</style>

<script>
  // Password authentication (only runs if not authenticated server-side)
  const authForm = document.getElementById('authForm');
  const authMessage = document.getElementById('authMessage');
  const lockContainer = document.querySelector('.lock-container');
  const passwordForm = document.getElementById('passwordForm');

  authForm?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const formData = new FormData(authForm as HTMLFormElement);
    const password = formData.get('password');

    try {
      const response = await fetch('/api/survey-auth', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ password }),
      });

      const result = await response.json();

      if (result.success) {
        // Trigger unlock animation
        if (lockContainer) {
          lockContainer.classList.add('unlocking');
        }

        // Wait for unlock animation (900ms) + pause (100ms), then fade out
        setTimeout(() => {
          if (passwordForm) {
            passwordForm.classList.add('fade-out');
          }
        }, 1000);

        // Wait for unlock (900ms) + pause (100ms) + fade out (400ms), then reload
        setTimeout(() => {
          window.location.reload();
        }, 1400);
      } else {
        if (authMessage) {
          authMessage.textContent = result.error || 'Invalid password';
          authMessage.className = 'form-message error';
        }
      }
    } catch (error) {
      if (authMessage) {
        authMessage.textContent = 'Authentication failed';
        authMessage.className = 'form-message error';
      }
    }
  });

  // Survey logic (only runs if authenticated)
  const userInfoForm = document.getElementById('userInfoForm');
  const userInfoStep = document.getElementById('userInfoStep');
  const questionsStep = document.getElementById('questionsStep');
  const successStep = document.getElementById('successStep');
  const questionContainer = document.getElementById('questionContainer');
  const prevBtn = document.getElementById('prevBtn');
  const nextBtn = document.getElementById('nextBtn');
  const submitBtn = document.getElementById('submitBtn');
  const questionCounter = document.getElementById('questionCounter');

  let questions: any[] = [];
  let currentQuestionIndex = 0;
  let userName = '';
  let userEmail = '';
  let responses: Record<string, string> = {};

  // Load questions from API
  async function loadQuestions() {
    try {
      const response = await fetch('/api/survey-questions');
      const result = await response.json();

      if (result.success) {
        questions = result.questions;
        showQuestion(0);
      } else {
        alert('Failed to load questions.');
      }
    } catch (error) {
      alert('Failed to load questions.');
    }
  }

  // Validate current answer and update button state
  function validateCurrentAnswer() {
    const question = questions[currentQuestionIndex];
    const answerElement = document.getElementById(`answer-${question.id}`) as HTMLInputElement | HTMLTextAreaElement;

    if (!answerElement) return;

    const value = answerElement.value.trim();
    const isValid = value.length > 0;

    // Enable/disable the appropriate button
    const isLastQuestion = currentQuestionIndex === questions.length - 1;
    if (isLastQuestion && submitBtn) {
      submitBtn.disabled = !isValid;
    } else if (nextBtn) {
      nextBtn.disabled = !isValid;
    }
  }

  // Show specific question
  function showQuestion(index: number) {
    if (!questionContainer || !questions.length) return;

    currentQuestionIndex = index;
    const question = questions[index];

    // Update question counter
    if (questionCounter) {
      questionCounter.textContent = `${index + 1}/${questions.length}`;
    }

    // Create question HTML
    const questionHTML = `
      <div class="question-card">
        <div class="question-text">
          ${question.question}
        </div>
        ${question.type === 'textarea'
          ? `<textarea rows="4" id="answer-${question.id}" placeholder="Your answer...">${responses[question.id] || ''}</textarea>`
          : `<input type="text" id="answer-${question.id}" placeholder="Your answer..." value="${responses[question.id] || ''}" />`
        }
      </div>
    `;

    questionContainer.innerHTML = questionHTML;

    // Update navigation buttons
    if (prevBtn) prevBtn.style.display = index === 0 ? 'none' : 'block';
    if (nextBtn) nextBtn.style.display = index === questions.length - 1 ? 'none' : 'block';
    if (submitBtn) submitBtn.style.display = index === questions.length - 1 ? 'block' : 'none';

    // Add real-time validation
    const answerElement = document.getElementById(`answer-${question.id}`) as HTMLInputElement | HTMLTextAreaElement;
    if (answerElement) {
      // Validate on input
      answerElement.addEventListener('input', validateCurrentAnswer);

      // Initial validation check
      validateCurrentAnswer();
    }
  }

  // Save current answer
  function saveCurrentAnswer() {
    const question = questions[currentQuestionIndex];
    const answerElement = document.getElementById(`answer-${question.id}`) as HTMLInputElement | HTMLTextAreaElement;

    if (answerElement) {
      responses[question.id] = answerElement.value;
    }
  }

  // User info form submission
  const userInfoMessage = document.getElementById('userInfoMessage');

  userInfoForm?.addEventListener('submit', (e) => {
    e.preventDefault();

    const formData = new FormData(userInfoForm as HTMLFormElement);
    const name = formData.get('name') as string;
    const email = formData.get('email') as string;

    // Clear previous error messages
    if (userInfoMessage) {
      userInfoMessage.textContent = '';
      userInfoMessage.className = 'form-message';
    }

    // Validate name (only letters and spaces)
    const nameRegex = /^[A-Za-z\s]+$/;
    if (!nameRegex.test(name)) {
      if (userInfoMessage) {
        userInfoMessage.textContent = 'Name must contain only letters and spaces.';
        userInfoMessage.className = 'form-message error';
      }
      return;
    }

    // Validate email format
    const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    if (!emailRegex.test(email)) {
      if (userInfoMessage) {
        userInfoMessage.textContent = 'Please enter a valid email address.';
        userInfoMessage.className = 'form-message error';
      }
      return;
    }

    userName = name;
    userEmail = email;

    // Hide user info, show questions
    if (userInfoStep) userInfoStep.style.display = 'none';
    if (questionsStep) questionsStep.style.display = 'block';

    loadQuestions();
  });

  // Navigation
  prevBtn?.addEventListener('click', () => {
    saveCurrentAnswer();
    showQuestion(currentQuestionIndex - 1);
  });

  nextBtn?.addEventListener('click', () => {
    saveCurrentAnswer();
    showQuestion(currentQuestionIndex + 1);
  });

  // Submit survey
  submitBtn?.addEventListener('click', async () => {
    saveCurrentAnswer();

    // Validate all questions answered
    const unanswered = questions.filter(q => !responses[q.id] || responses[q.id].trim() === '');
    if (unanswered.length > 0) {
      alert('Please answer all questions before submitting.');
      return;
    }

    // Disable submit button
    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.textContent = 'Submitting...';
    }

    try {
      const response = await fetch('/api/survey-submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          name: userName,
          email: userEmail,
          responses,
        }),
      });

      const result = await response.json();

      if (result.success) {
        // Show success message
        if (questionsStep) questionsStep.style.display = 'none';
        if (successStep) successStep.style.display = 'block';
      } else {
        alert(result.error || 'Submission failed');
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = 'Submit';
        }
      }
    } catch (error) {
      alert('Submission failed');
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Submit';
      }
    }
  });
</script>

</html>
