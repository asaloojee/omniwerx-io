---
import SurveyNav from '../components/SurveyNav.astro';
import Divider from '../components/Divider.astro';
import Footer from '../components/Footer.astro';
import Toast from '../components/Toast.astro';

// Check if survey is enabled at build time
const SURVEY_ENABLED = import.meta.env.SURVEY_ENABLED === true;

// Return 404 if survey disabled
if (!SURVEY_ENABLED) {
  return Astro.redirect('/404', 404);
}

// Check for auth cookie
const authCookie = Astro.cookies.get('survey_auth');
const isAuthenticated = authCookie && authCookie.value === 'authenticated';
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Survey - OMNIWERX</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="stylesheet" href="/global.css" />
</head>
<body class="survey-page">
  <main class="survey-main">
    <SurveyNav />
    <Divider first={true} />
    <section class="section survey-section">
      <div class="section-gutter"></div>
      <div class="section-wrapper">
        <div class="section-dot section-dot--left section-dot--top"></div>
        <div class="section-dot section-dot--right section-dot--top"></div>
        <div class="section-dot section-dot--left"></div>
        <div class="section-dot section-dot--right"></div>
        <div class="survey-content">
          {!isAuthenticated ? (
            <div id="passwordForm" class="survey-form">
              <div class="lock-container">
                <svg class="lock-icon" viewBox="-60 -35 220 155" xmlns="http://www.w3.org/2000/svg">
                  <!-- Lock shackle (upside-down U) -->
                  <path
                    class="lock-shackle"
                    d="M 14 46 L 14 22 C 14 10, 28 -9, 50 -9 C 72 -9, 86 10, 86 22 L 86 46"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="3"
                    stroke-linecap="round"
                  />
                  <!-- Lock body (flattened rectangle) -->
                  <rect
                    class="lock-body"
                    x="2"
                    y="46"
                    width="96"
                    height="72"
                    rx="8"
                    ry="8"
                    fill="transparent"
                    stroke="currentColor"
                    stroke-width="3"
                  />
                </svg>
              </div>
              <form id="authForm">
                <input type="password" name="password" placeholder="Password" required />
                <button type="submit">Access Survey</button>
              </form>
            </div>
          ) : (
            <div id="surveyForm" class="survey-form">
              <div id="userInfoStep">
                <h1 class="h2">Coaching Workflow Survey</h1>
                <p class="body-text">Thank you for taking the time to participate. Please enter your information below to begin.</p>
                <form id="userInfoForm" class="user-info-form">
                  <input type="text" name="name" placeholder="Name" required />
                  <input type="email" name="email" placeholder="Email" required />
                  <button type="submit">Start Survey</button>
                </form>
              </div>

              <div id="questionsStep" style="display: none;">
                <div class="question-header">
                  <div id="questionCounter" class="question-counter"></div>
                </div>
                <div id="questionContainer"></div>
                <div class="survey-navigation">
                  <button id="prevBtn" style="display: none;">Previous</button>
                  <button id="nextBtn">Next</button>
                  <button id="submitBtn" style="display: none;">Submit</button>
                </div>
              </div>

              <div id="successStep" style="display: none;">
                <div class="form-message success">
                  <h3 class="success-header">Thank you!</h3>
                  <p class="body-text">Your responses have been submitted.</p>
                </div>
              </div>
            </div>
          )}
        </div>
      </div>
      <div class="section-gutter"></div>
    </section>
    <Divider />
  </main>
  <Footer />
  <Toast />
</body>
</html>

<style is:global>
  /* Sticky footer layout */
  .survey-page {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  .survey-main {
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .survey-section {
    flex: 1;
  }

  .survey-section .section-wrapper {
    padding: 64px 32px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 100%;
  }

  .survey-content {
    max-width: 544px;
    margin: 0 auto;
    width: 100%;
  }

  .lock-container {
    background-color: rgba(204, 0, 24, 0.2);
    border: 2px solid var(--primary-red);
    border-radius: 12px;
    padding: 24px;
    display: flex;
    justify-content: center;
    align-items: center;
    margin: 0 auto 32px;
    width: 240px;
    height: 240px;
  }

  .lock-icon {
    width: 200px;
    height: 141px;
    color: var(--primary-red);
    transition: color 900ms ease-in-out;
  }

  .lock-shackle {
    transform-origin: 14px 46px;
  }

  .lock-container {
    transition:
      background-color 900ms ease-in-out,
      border-color 900ms ease-in-out;
  }

  .lock-container.unlocking {
    background-color: rgba(0, 128, 0, 0.2);
    border-color: #00ff00;
  }

  .lock-container.unlocking .lock-icon {
    color: #00ff00;
  }

  .lock-container.unlocking .lock-shackle {
    animation:
      shackle-raise 400ms ease-in-out forwards,
      shackle-swing 400ms ease-in-out 500ms forwards;
  }

  .survey-form.fade-out {
    animation: fadeOut 400ms ease-in-out forwards;
  }

  @keyframes fadeOut {
    from {
      opacity: 1;
    }
    to {
      opacity: 0;
    }
  }

  @keyframes shackle-raise {
    from {
      d: path("M 14 46 L 14 22 C 14 10, 28 -9, 50 -9 C 72 -9, 86 10, 86 22 L 86 46");
    }
    to {
      d: path("M 14 46 L 14 2 C 14 -10, 28 -29, 50 -29 C 72 -29, 86 -10, 86 2 L 86 26");
    }
  }

  @keyframes shackle-swing {
    from {
      d: path("M 14 46 L 14 2 C 14 -10, 28 -29, 50 -29 C 72 -29, 86 -10, 86 2 L 86 26");
    }
    to {
      d: path("M 14 46 L 14 2 C 14 -10, 0 -29, -22 -29 C -44 -29, -58 -10, -58 2 L -58 26");
    }
  }

  .survey-form {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .survey-form h1,
  .survey-form h2 {
    text-align: center;
  }

  .survey-form .body-text {
    text-align: center;
  }

  .survey-form form {
    display: grid;
    gap: 16px;
  }

  /* Password form - 2 rows */
  #authForm {
    grid-template-rows: 48px 48px;
  }

  /* User info form - 3 rows */
  #userInfoForm {
    grid-template-rows: 48px 48px 48px;
  }

  .survey-form input,
  .survey-form textarea {
    background-color: var(--input-background);
    border: 1px solid var(--card-border);
    border-radius: 4px;
    padding: 12px;
    color: var(--body-text);
    font-family: 'JetBrains Mono', monospace;
    font-size: 16px;
    font-weight: 300;
    width: 100%;
  }

  .survey-form input[type="text"],
  .survey-form input[type="email"],
  .survey-form input[type="password"] {
    height: 100%;
  }

  .survey-form input[type="password"] {
    letter-spacing: 0.5em;
    text-align: center;
  }

  .survey-form input[type="password"]::placeholder {
    letter-spacing: normal;
  }

  .survey-form input:focus,
  .survey-form textarea:focus {
    outline: none;
    background-color: var(--input-background--focus);
  }

  .survey-form button {
    background-color: var(--primary-red);
    color: var(--body-text--emphasis);
    border: none;
    border-radius: 8px;
    padding: 12px 24px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 16px;
    font-weight: 500;
    line-height: normal;
    cursor: pointer;
    text-transform: uppercase;
    box-shadow:
      0 0 16px rgba(204, 0, 24, 0.5),
      0 0 20px rgba(204, 0, 24, 0.3);
    max-height: 48px;
    box-sizing: border-box;
    max-height: 48px;
  }

  .survey-form button:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .question-header {
    display: flex;
    justify-content: flex-end;
    margin-bottom: 32px;
  }

  .question-counter {
    font-family: 'JetBrains Mono', monospace;
    font-size: 14px;
    font-weight: 500;
    color: var(--secondary-red);
    background: rgba(224, 31, 55, 0.2);
    padding: 4px 12px;
    border-radius: 16px;
    border: 1px solid var(--secondary-red);
    letter-spacing: 0.05em;
  }

  .question-card {
    margin-bottom: 32px;
  }

  .question-text {
    font-size: 20px;
    font-weight: 400;
    color: var(--body-text--emphasis);
    margin-bottom: 24px;
  }

  .options-container {
    display: grid;
    grid-template-columns: 1fr;
    grid-auto-rows: 1fr;
    gap: 12px;
  }

  .option-label {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 8px 16px;
    background-color: var(--input-background);
    border: 1px solid var(--card-border);
    border-radius: 4px;
    cursor: pointer;
    transition: all 0.2s ease;
    font-family: 'JetBrains Mono', monospace;
    font-size: 16px;
    font-weight: 300;
    color: var(--body-text);
    height: 100%;
  }

  .option-label:hover {
    background-color: var(--input-background--focus);
    border-color: var(--primary-red);
  }

  .option-label input[type="radio"],
  .option-label input[type="checkbox"] {
    appearance: none;
    -webkit-appearance: none;
    -moz-appearance: none;
    width: 18px;
    height: 18px;
    cursor: pointer;
    flex-shrink: 0;
    border: 2px solid var(--card-border);
    background-color: transparent;
    position: relative;
    transition: all 0.2s ease;
  }

  .option-label input[type="radio"] {
    border-radius: 50%;
  }

  .option-label input[type="checkbox"] {
    border-radius: 4px;
  }

  /* Checked state - inner fill */
  .option-label input[type="radio"]:checked {
    border-color: var(--secondary-red);
  }

  .option-label input[type="radio"]:checked::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background-color: var(--secondary-red);
  }

  .option-label input[type="checkbox"]:checked {
    border-color: var(--secondary-red);
    background-color: var(--secondary-red);
  }

  .option-label input[type="checkbox"]:checked::before {
    content: '✓';
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    color: var(--body-text--emphasis);
    font-size: 18px;
    font-weight: bold;
    line-height: 1;
  }

  /* Hover states - only border changes, no fill color change */
  .option-label:hover input[type="radio"]:not(:disabled),
  .option-label:hover input[type="checkbox"]:not(:disabled) {
    border-color: var(--secondary-red);
  }

  /* Ensure checked state doesn't darken on hover */
  .option-label:hover input[type="radio"]:checked::before,
  .option-label:hover input[type="checkbox"]:checked {
    background-color: var(--secondary-red);
  }

  .option-text {
    flex: 1;
    user-select: none;
  }

  textarea.other-input {
    margin-top: 8px;
    margin-bottom: 8px;
    margin-left: 32px;
    background-color: var(--input-background);
    border: 1px solid var(--card-border);
    border-radius: 4px;
    padding: 12px;
    color: var(--body-text);
    font-family: 'JetBrains Mono', monospace;
    font-size: 16px;
    font-weight: 300;
    width: calc(100% - 32px);
    box-sizing: border-box;
    resize: vertical;
  }

  textarea.other-input:focus {
    outline: none;
    background-color: var(--input-background--focus);
    border-color: var(--primary-red);
  }

  .survey-navigation {
    display: flex;
    justify-content: space-between;
    gap: 16px;
  }

  .survey-navigation button {
    flex: 1;
  }

  /* Secondary navigation buttons (Previous/Next) */
  #prevBtn,
  #nextBtn {
    background-color: transparent;
    border: 1px solid var(--primary-red);
    color: var(--primary-red);
    box-shadow: none;
    transition: all 0.2s ease;
  }

  #prevBtn:hover,
  #nextBtn:hover {
    background-color: rgba(204, 0, 24, 0.1);
    border-color: var(--secondary-red);
  }

  /* Primary submit button keeps the filled style */
  #submitBtn {
    /* Inherits default .survey-form button styles */
  }

  .form-message {
    padding: 12px;
    border-radius: 8px;
    text-align: center;
    font-family: 'JetBrains Mono', monospace;
    font-size: 14px;
  }

  .form-message.error {
    background-color: rgba(204, 0, 24, 0.2);
    border: 1px solid var(--primary-red);
    color: var(--primary-red);
  }

  .form-message.success {
    background-color: rgba(0, 128, 0, 0.2);
    border: 1px solid #00ff00;
    color: #00ff00;
    padding: 32px;
  }

  .success-header {
    font-family: 'JetBrains Mono', monospace;
    font-size: 32px;
    font-weight: 500;
    color: #00ff00;
    margin: 0 0 12px 0;
  }

  .form-message.success .body-text {
    margin: 0;
  }

  @media screen and (max-width: 768px) {
    .survey-section .section-wrapper {
      padding: 48px 16px;
    }

    .survey-navigation {
      flex-direction: column;
    }

    .survey-navigation button {
      width: 100%;
    }
  }
</style>

<script>
  import type { SurveyQuestion } from '../data/survey-questions';

  // Password authentication (only runs if not authenticated server-side)
  const authForm = document.getElementById('authForm');
  const lockContainer = document.querySelector('.lock-container');
  const passwordForm = document.getElementById('passwordForm');

  authForm?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const formData = new FormData(authForm as HTMLFormElement);
    const password = formData.get('password');

    try {
      const response = await fetch('/api/survey-auth', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ password }),
      });

      const result = await response.json();

      if (result.success) {
        // Trigger unlock animation
        if (lockContainer) {
          lockContainer.classList.add('unlocking');
        }

        // Wait for unlock animation (900ms) + pause (100ms), then fade out
        setTimeout(() => {
          if (passwordForm) {
            passwordForm.classList.add('fade-out');
          }
        }, 1000);

        // Wait for unlock (900ms) + pause (100ms) + fade out (400ms), then reload
        setTimeout(() => {
          window.location.reload();
        }, 1400);
      } else {
        window.showToast({
          type: 'error',
          message: result.error || 'Invalid password.',
        });
      }
    } catch (error) {
      window.showToast({
        type: 'error',
        message: 'Authentication failed.',
      });
    }
  });

  // Survey logic (only runs if authenticated)
  const userInfoForm = document.getElementById('userInfoForm');
  const userInfoStep = document.getElementById('userInfoStep');
  const questionsStep = document.getElementById('questionsStep');
  const successStep = document.getElementById('successStep');
  const questionContainer = document.getElementById('questionContainer');
  const prevBtn = document.getElementById('prevBtn');
  const nextBtn = document.getElementById('nextBtn');
  const submitBtn = document.getElementById('submitBtn');
  const questionCounter = document.getElementById('questionCounter');

  let questions: SurveyQuestion[] = [];
  let currentQuestionIndex = 0;
  let userName = '';
  let userEmail = '';
  let responses: Record<string, string | string[]> = {};

  // Load questions from API
  async function loadQuestions() {
    try {
      const response = await fetch('/api/survey-questions');
      const result = await response.json();

      if (result.success) {
        questions = result.questions;
        showQuestion(0);
      } else {
        alert('Failed to load questions.');
      }
    } catch (error) {
      alert('Failed to load questions.');
    }
  }

  // Validate current answer and update button state
  function validateCurrentAnswer() {
    const question = questions[currentQuestionIndex];
    let isValid = false;

    if (question.type === 'radio') {
      const selectedRadio = document.querySelector(`input[name="answer-${question.id}"]:checked`) as HTMLInputElement;

      if (selectedRadio) {
        // Check if "Other" is selected and requires text input
        if (question.hasOther && selectedRadio.value === 'Other') {
          const otherInput = document.getElementById(`other-${question.id}`) as HTMLTextAreaElement;
          isValid = otherInput && otherInput.value.trim().length > 0;
        } else {
          isValid = true;
        }
      }
    } else if (question.type === 'checkbox') {
      const checkedBoxes = document.querySelectorAll(`input[name="answer-${question.id}"]:checked`);

      if (checkedBoxes.length > 0) {
        // Check if "Other" is checked and requires text input
        const otherCheckbox = Array.from(checkedBoxes).find((cb: any) => cb.value === 'Other');
        if (question.hasOther && otherCheckbox) {
          const otherInput = document.getElementById(`other-${question.id}`) as HTMLTextAreaElement;
          isValid = otherInput && otherInput.value.trim().length > 0;
        } else {
          isValid = true;
        }
      }
    }

    // Enable/disable the appropriate button
    const isLastQuestion = currentQuestionIndex === questions.length - 1;
    if (isLastQuestion && submitBtn) {
      submitBtn.disabled = !isValid;
    } else if (nextBtn) {
      nextBtn.disabled = !isValid;
    }
  }

  // Show specific question
  function showQuestion(index: number) {
    if (!questionContainer || !questions.length) return;

    currentQuestionIndex = index;
    const question = questions[index];

    // Update question counter
    if (questionCounter) {
      questionCounter.textContent = `${index + 1}/${questions.length}`;
    }

    // Get previous responses
    const previousResponse = responses[question.id];
    const previousResponses = Array.isArray(previousResponse) ? previousResponse : [];
    const previousSingleResponse = typeof previousResponse === 'string' ? previousResponse : '';

    // Build options HTML
    let optionsHTML = '';

    if (question.type === 'radio') {
      optionsHTML = question.options.map((option) => {
        const isChecked = previousSingleResponse === option ? 'checked' : '';
        const isOther = option === 'Other';
        return `
          <label class="option-label">
            <input
              type="radio"
              name="answer-${question.id}"
              value="${option}"
              ${isChecked}
            />
            <span class="option-text">${option}</span>
          </label>
          ${isOther && question.hasOther ? `
            <textarea
              id="other-${question.id}"
              class="other-input"
              placeholder="Please specify..."
              rows="3"
              style="display: ${isChecked ? 'block' : 'none'};"
            ></textarea>
          ` : ''}
        `;
      }).join('');
    } else if (question.type === 'checkbox') {
      optionsHTML = question.options.map((option) => {
        const isChecked = previousResponses.includes(option) ? 'checked' : '';
        const isOther = option === 'Other';
        return `
          <label class="option-label">
            <input
              type="checkbox"
              name="answer-${question.id}"
              value="${option}"
              ${isChecked}
            />
            <span class="option-text">${option}</span>
          </label>
          ${isOther && question.hasOther ? `
            <textarea
              id="other-${question.id}"
              class="other-input"
              placeholder="Please specify..."
              rows="3"
              style="display: ${isChecked ? 'block' : 'none'};"
            ></textarea>
          ` : ''}
        `;
      }).join('');
    }

    // Create question HTML
    const questionHTML = `
      <div class="question-card">
        <div class="question-text">
          ${question.question}
        </div>
        <div class="options-container">
          ${optionsHTML}
        </div>
      </div>
    `;

    questionContainer.innerHTML = questionHTML;

    // Update navigation buttons
    if (prevBtn) prevBtn.style.display = index === 0 ? 'none' : 'block';
    if (nextBtn) nextBtn.style.display = index === questions.length - 1 ? 'none' : 'block';
    if (submitBtn) submitBtn.style.display = index === questions.length - 1 ? 'block' : 'none';

    // Add event listeners for showing/hiding "Other" field
    if (question.hasOther) {
      const otherInput = document.getElementById(`other-${question.id}`) as HTMLTextAreaElement;

      if (question.type === 'radio') {
        const radioInputs = document.querySelectorAll(`input[name="answer-${question.id}"]`);
        radioInputs.forEach((radio) => {
          radio.addEventListener('change', (e) => {
            const target = e.target as HTMLInputElement;
            if (otherInput) {
              otherInput.style.display = target.value === 'Other' && target.checked ? 'block' : 'none';
              if (target.value !== 'Other') {
                otherInput.value = '';
              }
            }
            validateCurrentAnswer();
          });
        });
      } else if (question.type === 'checkbox') {
        const checkboxInputs = document.querySelectorAll(`input[name="answer-${question.id}"]`);
        checkboxInputs.forEach((checkbox) => {
          checkbox.addEventListener('change', (e) => {
            const target = e.target as HTMLInputElement;
            if (target.value === 'Other' && otherInput) {
              otherInput.style.display = target.checked ? 'block' : 'none';
              if (!target.checked) {
                otherInput.value = '';
              }
            }
            validateCurrentAnswer();
          });
        });
      }

      // Add input listener to "Other" field for validation
      if (otherInput) {
        otherInput.addEventListener('input', validateCurrentAnswer);
      }
    } else {
      // Add change listeners for validation
      const inputs = document.querySelectorAll(`input[name="answer-${question.id}"]`);
      inputs.forEach((input) => {
        input.addEventListener('change', validateCurrentAnswer);
      });
    }

    // Initial validation check
    validateCurrentAnswer();
  }

  // Save current answer
  function saveCurrentAnswer() {
    const question = questions[currentQuestionIndex];

    if (question.type === 'radio') {
      const selectedRadio = document.querySelector(`input[name="answer-${question.id}"]:checked`) as HTMLInputElement;

      if (selectedRadio) {
        let answer = selectedRadio.value;

        // If "Other" is selected, append the text input value
        if (question.hasOther && selectedRadio.value === 'Other') {
          const otherInput = document.getElementById(`other-${question.id}`) as HTMLTextAreaElement;
          if (otherInput && otherInput.value.trim()) {
            answer = `Other: ${otherInput.value.trim()}`;
          }
        }

        responses[question.id] = answer;
      }
    } else if (question.type === 'checkbox') {
      const checkedBoxes = document.querySelectorAll(`input[name="answer-${question.id}"]:checked`) as NodeListOf<HTMLInputElement>;
      const selectedValues: string[] = [];

      checkedBoxes.forEach((checkbox) => {
        let value = checkbox.value;

        // If "Other" is checked, append the text input value
        if (question.hasOther && checkbox.value === 'Other') {
          const otherInput = document.getElementById(`other-${question.id}`) as HTMLTextAreaElement;
          if (otherInput && otherInput.value.trim()) {
            value = `Other: ${otherInput.value.trim()}`;
          }
        }

        selectedValues.push(value);
      });

      responses[question.id] = selectedValues;
    }
  }

  // User info form submission
  userInfoForm?.addEventListener('submit', (e) => {
    e.preventDefault();

    const formData = new FormData(userInfoForm as HTMLFormElement);
    const name = formData.get('name') as string;
    const email = formData.get('email') as string;

    // Validate name (only letters and spaces)
    const nameRegex = /^[A-Za-z\s]+$/;
    if (!nameRegex.test(name)) {
      window.showToast({
        type: 'error',
        message: 'Name must contain only letters and spaces.',
      });
      return;
    }

    // Validate email format
    const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    if (!emailRegex.test(email)) {
      window.showToast({
        type: 'error',
        message: 'Please enter a valid email address.',
      });
      return;
    }

    userName = name;
    userEmail = email;

    // Hide user info, show questions
    if (userInfoStep) userInfoStep.style.display = 'none';
    if (questionsStep) questionsStep.style.display = 'block';

    loadQuestions();
  });

  // Navigation
  prevBtn?.addEventListener('click', () => {
    saveCurrentAnswer();
    showQuestion(currentQuestionIndex - 1);
  });

  nextBtn?.addEventListener('click', () => {
    saveCurrentAnswer();
    showQuestion(currentQuestionIndex + 1);
  });

  // Submit survey
  submitBtn?.addEventListener('click', async () => {
    saveCurrentAnswer();

    // Validate all questions answered
    const unanswered = questions.filter(q => {
      const answer = responses[q.id];
      if (!answer) return true;
      if (Array.isArray(answer)) {
        return answer.length === 0;
      }
      return answer.trim() === '';
    });
    if (unanswered.length > 0) {
      alert('Please answer all questions before submitting.');
      return;
    }

    // Disable submit button
    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.textContent = 'Submitting...';
    }

    try {
      const response = await fetch('/api/survey-submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          name: userName,
          email: userEmail,
          responses,
        }),
      });

      const result = await response.json();

      if (result.success) {
        // Show success message
        if (questionsStep) questionsStep.style.display = 'none';
        if (successStep) successStep.style.display = 'block';
      } else {
        alert(result.error || 'Submission failed.');
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = 'Submit';
        }
      }
    } catch (error) {
      alert('Submission failed.');
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Submit';
      }
    }
  });
</script>

</html>
