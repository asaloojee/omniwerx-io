---
import BlenderLogo from "../components/BlenderLogo.astro";
import SectionCorners from "../components/SectionCorners.astro";
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Hello world</title>
  </head>
  <body>
    <header class="layout-grid">
      <nav class="content">
        <a>work</a>
        <a>pricing</a>
        <a>contact</a>
      </nav>
    </header>
    <main>
      <section id="hero" class="layout-grid">
        <img
          class="full-bleed-wordmark"
          src="/wordmark.svg"
          alt="Omniwerx"
          width="1047"
          height="146"
        />
        <div class="content">
          <h1>
            Digital interfaces & websites for startups & small businesses.
          </h1>
          <button class="button--emphasis">Start a project</button>
          <BlenderLogo />
        </div>
      </section>
      <section id="bridge" class="layout-grid">
        <div class="content">
          <p class="bridge__lead">
            omniwerx is a <strong>technical studio</strong> that designs and builds
            websites for <strong>startups</strong> and <strong
              >small brands</strong
            >. We own the entire process, from <strong>design</strong> to <strong
              >development</strong
            > to
            <strong> deployment</strong>, all within the existing framework of
            your business and the tools you're familiar with.
          </p>
        </div>
      </section>
    </main>
  </body>
</html>
