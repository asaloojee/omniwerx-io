---
import "../styles/global.css";
import BlenderLogo from "../components/BlenderLogo.astro";
import FaqAccordion from "../components/FaqAccordion.astro";
import Footer from "../components/Footer.astro";
import InlineLink from "../components/InlineLink.astro";
import checkCutoutAccent from "../assets/icons/check--cutout-accent.svg";
import checkCutoutPwhite from "../assets/icons/check--cutout-pwhite.svg";
import wordmark from "../assets/images/brand/wordmark.svg";
import wordmark_embossed from "../assets/images/brand/wordmark-embossed.png";
import profileImage from "../assets/images/portraits/abdurahmaan-saloojee.jpg";
import jordanShallowImage from "../assets/images/portraits/jordan-shallow.jpg";
import socialImage from "../assets/images/social/og-image.png";
import jcHealthPerformanceImage from "../assets/images/work/jc-health-performance.jpg";
import preScriptImage from "../assets/images/work/pre-script.jpg";
import spokenLiveImage from "../assets/images/work/spoken-live.jpg";
import Image from "astro/components/Image.astro";

const title = "Omniwerx®";
const description =
  "Omniwerx® designs and builds custom websites, interfaces, and products for startups and founder-led businesses.";
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
const socialImageUrl = new URL(socialImage.src, Astro.site ?? Astro.url);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="oklch(0.117 0.003 27.557)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Omniwerx®" />
    <meta property="og:locale" content="en_CA" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="2400" />
    <meta property="og:image:height" content="1260" />
    <meta
      property="og:image:alt"
      content="Omniwerx® web design and development"
    />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta
      name="twitter:image:alt"
      content="Omniwerx® web design and development"
    />
  </head>
  <body>
    <main>
      <section id="hero">
        <div class="hero__wordmark">
          <div class="meta-row">omnx_01::<em>wordmark</em></div>
          <div class="hero__wordmark__container">
            <Image
              src={wordmark_embossed}
              alt="Omniwerx®"
              class="hero__wordmark__img"
            />
          </div>
        </div>
        <div class="hero__content">
          <div class="hero__content__lead">
            <div class="meta-row">
              omnx_02::<em>statement</em>
            </div>
            <h1>
              Omniwerx&reg; is the development and design consultancy of
              Abdurahmaan Saloojee, specializing in websites, product
              interfaces, and custom software for growing businesses.
            </h1>
          </div>
          <div class="hero__content__model">
            <div class="meta-row">
              omnx_03::<em>model</em>
            </div>
            <BlenderLogo />
          </div>
        </div>
      </section>
      <section id="details">
        <div class="details__about">
          <div class="meta-row">
            omnx_04::<em>capabilities</em>
          </div>
          <h2 class="details__title">Websites, Interfaces, & Software</h2>
          <p class="details__text">
            Omniwerx&reg; builds marketing websites, product interfaces, and
            custom software for founder-led business and small teams.
          </p>
          <p class="details__text">Our specialties include:</p>
          <ul>
            <li>Website branding</li>
            <li>Product landing pages</li>
            <li>Email marketing infrastructure</li>
          </ul>
        </div>
        <div class="details__services">
          <div class="meta-row">
            omnx_5::<em>principal</em>
          </div>
          <h2 class="details__title">Abdurahmaan Saloojee</h2>
          <p class="details__text">
            I'm a developer and designer from Ottawa, Canada, and I care deeply
            about product and user experience. I currently work as a software
            engineer at Pre-Script&reg;.
          </p>
          <p class="details__text">
            Through Omniwerx&reg;, I help clients establish and refine their
            digital presence through design and implementation.
          </p>
          <p class="details__text">
            <InlineLink href="mailto:asaloojee@omniwerx.io" arrow
              >asaloojee@omniwerx.io</InlineLink
            >
          </p>
        </div>
        <div class="details__contact">
          <div class="meta-row">
            omnx_06::<em>engagements</em>
          </div>
          <h2 class="details__title">Projects & Retainers</h2>
          <p class="details__text">
            Projects are fixed-term, scoped engagements that begin with the
            identification of a specific problem or task and conclude with the
            handoff of a defined deliverable.
          </p>
          <p class="details__text">
            Retainers are ongoing and suited to businesses that have a backlog
            of work with evolving properties that they want to tackle with a
            rolling queue.
          </p>
          <p class="details__text">
            <InlineLink href="mailto:info@omniwerx.io" arrow
              >Discuss an engagement</InlineLink
            >
          </p>
        </div>
      </section>
    </main>
    <Footer />
  </body>
</html>
