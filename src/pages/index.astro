---
import "../styles/global.css";
import BlenderLogo from "../components/BlenderLogo.astro";
import FaqAccordion from "../components/FaqAccordion.astro";
import Footer from "../components/Footer.astro";
import InlineLink from "../components/InlineLink.astro";
import checkCutoutAccent from "../assets/icons/check--cutout-accent.svg";
import checkCutoutPwhite from "../assets/icons/check--cutout-pwhite.svg";
import wordmark from "../assets/images/brand/wordmark.svg";
import wordmark_embossed from "../assets/images/brand/wordmark-embossed.png";
import wordmarkEmbossedMobile from "../assets/images/brand/wordmark-embossed--mobile.png";
import profileImage from "../assets/images/portraits/abdurahmaan-saloojee.jpg";
import jordanShallowImage from "../assets/images/portraits/jordan-shallow.jpg";
import socialImage from "../assets/images/social/og-image.png";
import jcHealthPerformanceImage from "../assets/images/work/jc-health-performance.jpg";
import preScriptImage from "../assets/images/work/pre-script.jpg";
import spokenLiveImage from "../assets/images/work/spoken-live.jpg";
import Image from "astro/components/Image.astro";
import { getImage } from "astro:assets";

const mobileWordmark = await getImage({
  src: wordmarkEmbossedMobile,
  width: 1200,
  format: "webp",
});

const title = "Omniwerx®";
const description =
  "Omniwerx® designs and builds custom websites, interfaces, and products for startups and founder-led businesses.";
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
const socialImageUrl = new URL(socialImage.src, Astro.site ?? Astro.url);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="oklch(0.117 0.003 27.557)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Omniwerx®" />
    <meta property="og:locale" content="en_CA" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="2400" />
    <meta property="og:image:height" content="1260" />
    <meta
      property="og:image:alt"
      content="Omniwerx® web design and development"
    />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta
      name="twitter:image:alt"
      content="Omniwerx® web design and development"
    />
  </head>
  <body>
    <main>
      <section id="hero">
        <div class="hero__wordmark">
          <div class="meta-row">omnx_01::<em>wordmark</em></div>
          <div class="hero__wordmark__container">
            <picture>
              <source
                media="(max-width: 991px)"
                srcset={mobileWordmark.src}
                type="image/webp"
                width={mobileWordmark.attributes.width}
                height={mobileWordmark.attributes.height}
              />
              <Image
                src={wordmark_embossed}
                alt="Omniwerx®"
                class="hero__wordmark__img"
              />
            </picture>
          </div>
        </div>
        <div class="hero__content">
          <div class="hero__content__lead">
            <div class="meta-row">
              omnx_02::<em>statement</em>
            </div>
            <h1>
              Omniwerx&reg; is the development and design consultancy of
              Abdurahmaan Saloojee, specializing in websites, product
              interfaces, and custom software for growing businesses.
            </h1>
          </div>
          <div class="hero__content__model">
            <div class="meta-row">
              omnx_03::<em>model</em>
            </div>
            <BlenderLogo />
          </div>
        </div>
      </section>
      <section id="details">
        <div class="details__about">
          <div class="meta-row">
            omnx_04::<em>capabilities</em>
          </div>
          <h2 class="details__title">The work at a glance</h2>
          <div class="details__list">
            <article class="details__list-item">
              <span class="list__index">01</span>
              <h3>Website</h3>
              <p>
                Building and reinforcing your web presence through branding,
                design, and implementation.
              </p>
            </article>
            <article class="details__list-item">
              <span class="list__index">02</span>
              <h3>Product</h3>
              <p>
                Refining your product through compelling sales pages and
                thoughtful customer journeys.
              </p>
            </article>
            <article class="details__list-item">
              <span class="list__index">03</span>
              <h3>Marketing</h3>
              <p>
                Giving your product more polish, creating digital assets, and
                supporting email marketing operations.
              </p>
            </article>
          </div>
        </div>
        <div class="details__services">
          <div class="meta-row">
            omnx_5::<em>engagements</em>
          </div>
          <h2 class="details__title">How we work together</h2>
          <article class="details__engagement details__engagement--project">
            <div class="details__engagement-meta">
              <em>project</em>::fixed
            </div>
            <div class="details__engagement-body">
              <p>A focused sprint to deliver a defined result.</p>
              <div class="details__engagement-footer">
                <div class="details__engagement-price">
                  <span>Starting at</span>
                  <span>$5,000</span>
                </div>
                <p class="details__engagement-action">
                  <InlineLink href="mailto:info@omniwerx.io" arrow
                    >Discuss a project</InlineLink
                  >
                </p>
              </div>
            </div>
          </article>
          <article class="details__engagement details__engagement--retainer">
            <div class="details__engagement-meta">
              <em>retainer</em>::ongoing
            </div>
            <div class="details__engagement-body">
              <p>Steady support for evolving needs.</p>
              <div class="details__engagement-footer">
                <div class="details__engagement-price">
                  <span>Monthly from</span>
                  <span>$3,000</span>
                </div>
                <p class="details__engagement-action">
                  <InlineLink href="mailto:info@omniwerx.io" arrow
                    >Discuss a retainer</InlineLink
                  >
                </p>
              </div>
            </div>
          </article>
        </div>
        <div class="details__contact">
          <div class="meta-row">
            omnx_06::<em>founder</em>
          </div>
          <h2 class="details__title">Abdurahmaan Saloojee</h2>
          <p class="details__text">
            <Image
              src={profileImage}
              alt="Portrait of Abdurahmaan Saloojee"
              class="details__founder-headshot"
            />
            I'm a developer and designer from Ottawa, Canada, and I care deeply about
            product and user experience. I currently build web products and support
            marketing infrastructure at Pre-Script&reg;.
          </p>
          <p class="details__text">
            Through Omniwerx&reg;, I help clients refine their digital presence
            with custom software and reinforce their operations with supporting
            infrastructure. Thoughtful design and careful engineering are the
            tools I use to address a business need and deliver a polished
            solution.
          </p>
          <p class="details__text">
            <InlineLink href="mailto:info@omniwerx.io" arrow
              >Let's talk</InlineLink
            >
          </p>
        </div>
      </section>
    </main>
    <Footer />
  </body>
</html>
