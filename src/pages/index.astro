---
import BlenderLogo from "../components/BlenderLogo.astro";
import Nav from "../components/Nav.astro";
import Divider from "../components/Divider.astro";
import PrimaryButton from "../components/PrimaryButton.astro";
import SectionCorners from "../components/SectionCorners.astro";
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>omniwerx</title>
  </head>
  <body>
    <header class="page-grid">
      <Nav />
    </header>
    <main>
      <section id="hero" class="page-grid">
        <div class="section-frame">
          <div class="section-content">
            <h1>Precision-engineered websites and interfaces.</h1>
            <div class="hero__lead">
              <span class="hero__lead--emphasis"
                >We design and build custom websites and digital interfaces for
                startups and founder-led businesses.</span
              > From tool integrations to customer flows to brand messaging, we help
              you present your product or service with greater clarity, credibility,
              and polish.
            </div>
            <PrimaryButton href="#contact">Start a Project</PrimaryButton>
          </div>
        </div>
        <Divider />
      </section>
    </main>
  </body>
</html>
