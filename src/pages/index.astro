---
import BadgeHero from "../components/BadgeHero.astro";
import SectionMarker from "../components/SectionMarker.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Omniwerx</title>
    <link rel="stylesheet" href="/global.css" />
  </head>
  <body>
    <nav class="nav">
      <div class="wrapper">
        <div class="nav__wordmark">omniwerx</div>
        <a class="nav__link">start a conversation</a>
      </div>
    </nav>
    <section class="hero">
      <div class="wrapper">
        <div class="hero__label">[00 / overview]</div>
        <h1 class="hero__h1">
          Web solutions for fitness and small businesses.
        </h1>
        <button class="button hero__button" type="button">
          <span>solutions</span>
        </button>
        <div class="hero__badge">
          <BadgeHero />
        </div>
      </div>
    </section>

    <!-- <SectionMarker /> -->

    <section class="section about" aria-labelledby="about-heading">
      <div class="section__inner section__inner--narrow">
        <div class="about__label">[01 / about]</div>
        <h2 class="about__heading" id="about-heading">
          A focused web practice.
        </h2>
        <p class="about__copy">
          Omniwerx is an independent web development practice focused on
          frontend implementation and interface design for fitness, health, and
          small business operators.
        </p>
      </div>
    </section>
  </body>

  <script is:inline>
    const nav = document.querySelector(".nav");

    if (nav) {
      const setScrolled = () => {
        nav.dataset.scrolled = window.scrollY > 8 ? "true" : "false";
      };

      setScrolled();
      window.addEventListener("scroll", setScrolled, { passive: true });
    }
  </script>
</html>
