---
import "../styles/global.css";
import Divider from "../components/Divider.astro";
import Spacer from "../components/Spacer.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>omniwerx</title>
  </head>
  <body>
    <header>
      <nav>
        <a href="/" class="nav__img-link">
          <img src="/wordmark.svg" alt="" class="nav__img" />
        </a>
        <div class="nav__links">
          <a href="/" class="nav__link">Services</a>
          <a href="" class="accent-button">Contact</a>
        </div>
      </nav>
    </header>
    <main>
      <section id="hero">
        <h1>Precision-engineered websites & interfaces.</h1>
        <p class="hero__lead">
          <strong
            >We design and build custom websites for startups and founder-led
            businesses.</strong
          > We elevate your product and strengthen your brand through polished interfaces,
          thoughtful customer journeys, and reliable infrastructure integration.
        </p>
        <a href="/" class="accent-button accent-button--primary"
          >Start a project</a
        >
      </section>
      <section id="work">
        <p class="label">Work</p>
        <h2>A selection of our projects.</h2>
        <div class="work__projects">
          <article class="work__project">
            <div class="work__project__index">001</div>
            <div class="work__project__image">
              <div
                class="work__project__image__asset work__project__image__asset--pre-script"
                role="img"
                aria-label="Pre-Script website"
              >
              </div>
            </div>
            <div class="work__project__content">
              <p class="work__project__title">Pre-Script&reg;</p>
              <p class="work__project__desc">
                An education platform for fitness professionals.
              </p>
              <div class="work__project__meta-row">
                <p class="work__project__meta__key">Engagement</p>
                <p class="work__project__meta__value">Retainer</p>
              </div>
              <div class="work__project__meta-row">
                <p class="work__project__meta__key">Year</p>
                <p class="work__project__meta__value">2023-Present</p>
              </div>
            </div>
          </article>
          <div class="work__projects__spacer"></div>
          <article class="work__project">
            <div class="work__project__index">002</div>
            <div class="work__project__image">
              <div
                class="work__project__image__asset work__project__image__asset--spoken-live"
                role="img"
                aria-label="Spoken Live website"
              >
              </div>
            </div>
            <div class="work__project__content">
              <p class="work__project__title">Spoken Live</p>
              <p class="work__project__desc">
                A registration page for a fitness networking event.
              </p>
              <div class="work__project__meta-row">
                <p class="work__project__meta__key">Engagement</p>
                <p class="work__project__meta__value">Project</p>
              </div>
              <div class="work__project__meta-row">
                <p class="work__project__meta__key">Year</p>
                <p class="work__project__meta__value">2026</p>
              </div>
            </div>
          </article>
          <div class="work__projects__spacer"></div>
          <article class="work__project">
            <div class="work__project__index">003</div>
            <div class="work__project__image">
              <div
                class="work__project__image__asset work__project__image__asset--jc-hp"
                role="img"
                aria-label="JC website"
              >
              </div>
            </div>
            <div class="work__project__content">
              <p class="work__project__title">JC Health & Performance</p>
              <p class="work__project__desc">
                A brand kit & landing page for a personal trainer.
              </p>
              <div class="work__project__meta-row">
                <p class="work__project__meta__key">Engagement</p>
                <p class="work__project__meta__value">Project</p>
              </div>
              <div class="work__project__meta-row">
                <p class="work__project__meta__key">Year</p>
                <p class="work__project__meta__value">2025</p>
              </div>
            </div>
          </article>
        </div>
      </section>
      <section id="services"></section>
    </main>
  </body>
</html>
