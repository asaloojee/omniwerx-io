---
import BlenderLogo from "../components/BlenderLogo.astro";
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Hello world</title>
  </head>
  <body>
    <main>
      <section id="hero">
        <img
          class="hero__wordmark"
          src="/wordmark.svg"
          width="1106"
          height="157"
          alt="Omniwerx"
        />
        <p class="hero__lead">
          Digital interfaces and websites for startups and small brands.
        </p>
        <BlenderLogo />
      </section>
      <section id="services" class="layout-wide">
        <h2>Custom by design, precise in execution.</h2>
        <p>
          We design distinctive interfaces and websites, then implement them
          within the platforms and systems that your business already relies on.
        </p>
        <div class="service-register">
          <div class="service-register__row service-register__header">
            <span>No.</span>
            <span>Name</span>
            <span>Application</span>
          </div>
          <article class="service-register__row service-register__item">
            <p class="service-register__number">01</p>
            <h3 class="service-register__name">Service name placeholder</h3>
            <div class="service-register__application">
              <p>
                Application description placeholder for a concise overview of
                the service and its intended use.
              </p>
              <p class="service-register__meta">[TAG 01] [TAG 02]</p>
            </div>
          </article>
          <article class="service-register__row service-register__item">
            <p class="service-register__number">02</p>
            <h3 class="service-register__name">Service name placeholder</h3>
            <div class="service-register__application">
              <p>
                Application description placeholder for a concise overview of
                the service and its intended use.
              </p>
              <p class="service-register__meta">[TAG 01] [TAG 02]</p>
            </div>
          </article>
          <article class="service-register__row service-register__item">
            <p class="service-register__number">03</p>
            <h3 class="service-register__name">Service name placeholder</h3>
            <div class="service-register__application">
              <p>
                Application description placeholder for a concise overview of
                the service and its intended use.
              </p>
              <p class="service-register__meta">[TAG 01] [TAG 02]</p>
            </div>
          </article>
          <article class="service-register__row service-register__item">
            <p class="service-register__number">04</p>
            <h3 class="service-register__name">Service name placeholder</h3>
            <div class="service-register__application">
              <p>
                Application description placeholder for a concise overview of
                the service and its intended use.
              </p>
              <p class="service-register__meta">[TAG 01] [TAG 02]</p>
            </div>
          </article>
        </div>
      </section>
    </main>
  </body>
</html>
