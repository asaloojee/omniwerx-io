---
import BlenderLogo from "../components/BlenderLogo.astro";
import Divider from "../components/Divider.astro";
import SectionCorners from "../components/SectionCorners.astro";
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>omniwerx</title>
  </head>
  <body>
    <header>
      <nav class="layout-grid">
        <div class="breakout">
          <SectionCorners position="top" />
          <a class="nav__img-link">
            <img class="nav__img" src="wordmark.svg" />
          </a>
          <div class="nav__links">
            <a>work</a>
            <a>pricing</a>
            <a>contact</a>
          </div>
          <SectionCorners position="bottom" />
        </div>
      </nav>
    </header>
    <main>
      <section id="hero" class="layout-grid">
        <Divider sectionDots="bottom" />
        <div class="content">
          <h1>
            Custom websites & interfaces for startups & founder-led businesses.
          </h1>
        </div>
      </section>
    </main>
  </body>
</html>
