---
import "../styles/global.css";
import BlenderLogo from "../components/BlenderLogo.astro";
import FaqAccordion from "../components/FaqAccordion.astro";
import Footer from "../components/Footer.astro";
import InlineLink from "../components/InlineLink.astro";
import checkCutoutAccent from "../assets/icons/check--cutout-accent.svg";
import checkCutoutPwhite from "../assets/icons/check--cutout-pwhite.svg";
import wordmark from "../assets/images/brand/wordmark.svg";
import wordmark_embossed from "../assets/images/brand/wordmark-embossed.png";
import profileImage from "../assets/images/portraits/abdurahmaan-saloojee.jpg";
import jordanShallowImage from "../assets/images/portraits/jordan-shallow.jpg";
import socialImage from "../assets/images/social/og-image.png";
import jcHealthPerformanceImage from "../assets/images/work/jc-health-performance.jpg";
import preScriptImage from "../assets/images/work/pre-script.jpg";
import spokenLiveImage from "../assets/images/work/spoken-live.jpg";
import Image from "astro/components/Image.astro";

const title = "Omniwerx®";
const description =
  "Omniwerx® designs and builds custom websites, interfaces, and products for startups and founder-led businesses.";
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
const socialImageUrl = new URL(socialImage.src, Astro.site ?? Astro.url);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="oklch(0.117 0.003 27.557)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Omniwerx®" />
    <meta property="og:locale" content="en_CA" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="2400" />
    <meta property="og:image:height" content="1260" />
    <meta
      property="og:image:alt"
      content="Omniwerx® web design and development"
    />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta
      name="twitter:image:alt"
      content="Omniwerx® web design and development"
    />
  </head>
  <body>
    <header></header>
    <main>
      <section id="hero">
        <div class="hero__wordmark">
          <div class="meta-row">fig_01: <em>omnx.wordmark</em></div>
          <div class="hero__wordmark__container">
            <Image
              src={wordmark_embossed}
              alt="Omniwerx®"
              class="hero__wordmark__img"
            />
          </div>
        </div>
        <div class="hero__content">
          <div class="hero__content__lead">
            <div class="meta-row">
              fig_02: <em>omnx.statement</em>
            </div>
            <p>
              Omniwerx&reg; is a consultancy that specializes in web design,
              software development, and digital systems for growing businesses.
            </p>
          </div>
          <div class="hero__content__model">
            <div class="meta-row">
              fig_03: <em>omnx.model</em>
            </div>
            <BlenderLogo />
          </div>
        </div>
      </section>
      <section id="details">
        <div class="details__about">
          <div class="meta-row">
            fig_04: <em>omnx.about</em>
          </div>
          <div class="details__title">About the Founder</div>
          <p class="details__text">
            Abdurahmaan Saloojee is a developer and designer focused on product
            and user experience. He currently works as a software engineer at <InlineLink
              href="https://www.pre-script.com">Pre-Script&reg;</InlineLink
            >.
          </p>
          <p class="details__text">
            Through Omniwerx&reg;, he works with founder-led businesses and
            small teams to elevate product, refine user interfaces, and build
            solutions.
          </p>
        </div>
        <div class="details__services">
          <div class="meta-row">
            fig_05: <em>omnx.services</em>
          </div>
          <div class="details__title">Our Services</div>
          <div class="details__text">
            We offer two types of engagements: Projects & Retainers.
          </div>
          <div class="details__text">
            Projects are fixed-term, scoped engagements that begin with the
            identification of a specific problem or task and conclude with the
            handoff of a defined deliverable.
          </div>
          <div class="details__text">
            Retainers are ongoing and suited to businesses that have a backlog
            of work with evolving properties that they want to tackle with a
            rolling queue.
          </div>
        </div>
        <div class="details__contact">
          <div class="meta-row">
            fig_06: <em>omnx.contact</em>
          </div>
          <div class="details__title">Contact Us</div>
        </div>
      </section>
    </main>
  </body>
</html>
