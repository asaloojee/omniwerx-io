---
import BlenderLogo from "../components/BlenderLogo.astro";
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Hello world</title>
  </head>
  <body>
    <main>
      <section id="hero">
        <img
          class="hero__wordmark"
          src="/wordmark.svg"
          width="1106"
          height="157"
          alt="Omniwerx"
        />
        <p class="hero__lead">
          Digital interfaces and websites for startups and small brands.
        </p>
        <BlenderLogo />
      </section>
      <section id="bridge">
        <p class="bridge__lead">
          omniwerx is a <strong>technical studio</strong> that designs and builds
          websites for <strong>startups</strong> and <strong
            >small brands</strong
          >. We own the entire process, from <strong>design</strong> to <strong
            >development</strong
          > to
          <strong> deployment</strong>, all within the existing framework of
          your business and the tools you're familiar with.
        </p>
      </section>
    </main>
  </body>
</html>
