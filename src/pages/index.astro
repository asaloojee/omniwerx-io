---
import BlenderLogo from "../components/BlenderLogo.astro";
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Hello world</title>
  </head>
  <body>
    <header>
      <nav>
        <a class="nav__img-link">
          <img src="/wordmark.svg" />
        </a>
        <div>
          <a>work</a>
          <a>pricing</a>
          <a>contact</a>
        </div>
      </nav>
    </header>
    <main>
      <section id="hero">
        <div class="hero__content">
          <h1>Digital interfaces and websites for startups and small brands.</h1>
          <div class="hero__cta">
            <button class="button--emphasis" type="button">start a project</button>
          </div>
        </div>
        <div class="hero__graphic">
          <div class="hero__surface" aria-hidden="true"></div>
          <div class="hero__light-shaft" aria-hidden="true"></div>
          <BlenderLogo />
        </div>
      </section>
      <section id="bridge">
        <p class="bridge__lead">
          omniwerx is a <strong>technical studio</strong> that designs and builds
          websites for <strong>startups</strong> and <strong
            >small brands</strong
          >. We own the entire process, from <strong>design</strong> to <strong
            >development</strong
          > to
          <strong> deployment</strong>, all within the existing framework of
          your business and the tools you're familiar with.
        </p>
      </section>
    </main>
  </body>
</html>
