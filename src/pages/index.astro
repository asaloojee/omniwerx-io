---
import Divider from '../components/Divider.astro';
import TerminalDivider from '../components/TerminalDivider.astro';
---

<!doctype html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>OMNIWERX</title>

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- Preconnect for Performance -->
  <link rel="preconnect" href="https://kit.fontawesome.com" />

  <!-- Stylesheets -->
  <link rel="stylesheet" href="/global.css" />

  <!-- Font Awesome -->
  <script src="https://kit.fontawesome.com/83ef228eb4.js" crossorigin="anonymous"></script>
</head>

<body>
  <main>
    <div class="navbar-framework">
      <div class="navbar-framework-gutter"></div>
      <div class="navbar-framework-wrapper"></div>
      <div class="navbar-framework-gutter"></div>
    </div>
    <nav class="section navbar" id="navbar" role="navigation" aria-label="Main navigation">
      <div class="section-gutter"></div>
      <div class="section-wrapper">
        <div class="section-dot section-dot--left section-dot--top"></div>
        <div class="section-dot section-dot--right section-dot--top"></div>
        <div class="section-dot section-dot--left"></div>
        <div class="section-dot section-dot--right"></div>
        <div class="nav-wrapper">
          <div class="nav-left">
            <div class="nav-logo">
              <img src="/hero-logo.png" alt="OMNIWERX Logo - Digital Solutions Architect" loading="eager" />
            </div>
            <button class="nav-mobile-toggle">
              <i class="fa-solid fa-bars"></i>
            </button>
          </div>
          <div class="nav-right">
            <a href="#about" class="nav-link">about</a>
            <a href="#mission" class="nav-link">mission</a>
            <a href="#services" class="nav-link">services</a>
            <a href="#contact" class="nav-link nav-link--contact">contact</a>
          </div>
        </div>
      </div>
      <div class="section-gutter"></div>
    </nav>
    <Divider first={true} />
    <section class="section hero" role="banner">
      <div class="section-gutter"></div>
      <div class="section-wrapper">
        <div class="hero__content-wrapper">
          <div class="hero__h1-wrapper">
              <div class="h1">We handle the websites and systems – <span class="emphasis--red">you handle the exceptional.</span></div>
          </div>
          <div class="hero__content">
            <div class="hero__content__features">
              <div class="hero__content__feature">
                <i class="fa-solid fa-chevron-right"></i>
                <div class="hero__content__feature__text">Digital Design</div>
              </div>
              <div class="hero__content__feature">
                <i class="fa-solid fa-chevron-right"></i>
                <div class="hero__content__feature__text">Web Development</div>
              </div>
              <div class="hero__content__feature">
                <i class="fa-solid fa-chevron-right"></i>
                <div class="hero__content__feature__text">
                  Business Architecture
                </div>
              </div>
            </div>
            <div class="hero__content__body-text">
              Everything you need – <span class="body-text--emphasis">all in one place.</span>
            </div>
            <div class="hero__content__cta">
              <a href="#about" class="link"> About Us </a>
              <a href="#contact" class="button"> Contact </a>
            </div>
          </div>
        </div>
      </div>
      <div class="section-gutter"></div>
    </section>
    <Divider />
    <section id="about" class="section alt-section" role="region" aria-labelledby="about-heading">
      <div class="section-gutter"></div>
      <div class="section-wrapper">
        <div class="about__content-wrapper">
          <div class="about__content">
            <div class="badge">Meet the Founder</div>
            <h2 id="about-heading" class="h2">Innovative craftsmanship meets uncompromising precision.</h2>
            <div class="about__content__body">
              <div class="body-text">
                  OMNIWERX is the project of Abdurahmaan Saloojee. Born in Ottawa, Canada, his experience took him from fitness to software.
                  He works as a consultant to help business set themselves up for success in the digital arena.
              </div>
              <div class="body-text">
                His method is rooted in problem-solving: bridging the gap between where you are now, and where you want to get to.
              </div>
            </div>
          </div>
          <div class="about__image-wrapper">
            <img src="/headshot.jpg" alt="Abdurahmaan Saloojee Headshot" loading="lazy" />
          </div>
        </div>
      </div>
      <div class="section-gutter"></div>
    </section>
    <Divider />
    <section id="mission" class="section reg-section" role="region" aria-labelledby="mission-heading">
      <div class="section-gutter"></div>
      <div class="section-wrapper">
        <div class="about__content-wrapper">
          <div class="about__content">
            <div class="badge">Our Approach</div>
            <h2 id="mission-heading" class="h2">Architecting digital excellence.</h2>
            <div class="about__content__body">
              <div class="body-text">
                OMNIWERX is a <span class="body-text--emphasis">Digital Solutions Architect</span>. We provide
                consulting services that cover all of your
                business needs – from brand identity to digital design to web
                development to business architecture.
              </div>
              <div class="body-text">
                In a constantly evolving world with ever-changing tools and
                standards, we fulfill the growing need for safety, reliability,
                and comfort. We help you unify your processes and systems and
                lift it off your shoulders – <span class="body-text--emphasis">so that you can go change the
                  world.</span>
              </div>
            </div>
          </div>
          <div class="about__image-wrapper">
            <img src="/logo-grid-graphic.png" alt="OMNIWERX Digital Solutions Architecture Services" loading="lazy" />
          </div>
        </div>
      </div>
      <div class="section-gutter"></div>
    </section>
    <Divider />
    <section id="services" class="section reg-section" role="region" aria-labelledby="services-heading">
      <div class="section-gutter"></div>
      <div class="section-wrapper">
        <div class="services__content-wrapper">
          <div class="services__content">
            <div class="badge">What we do</div>
            <h2 id="services-heading" class="h2">A peek behind the curtain.</h2>
            <div class="services__content__body">
              <div class="body-text">
                We provide consulting services that cover all of your business
                needs – from brand identity to graphic design to website
                development to operational infrastructure.
              </div>
            </div>
            <div class="services__content__cards">
              <div class="services__content__card">
                <div class="services__content__card__header">
                  <div class="services__content__card__header__icon">
                    <i class="fa-solid fa-pen-ruler"></i>
                  </div>
                  <div class="services__content__card__header__text">
                    Design
                  </div>
                </div>
                <div class="services__content__card__body">
                  Have a vision for a product or service, but not sure how you
                  want it to look? Want to advertise, but not sure how you want
                  it to look? We can help.
                </div>
              </div>
              <div class="services__content__card">
                <div class="services__content__card__header">
                  <div class="services__content__card__header__icon">
                    <i class="fa-solid fa-laptop-code"></i>
                  </div>
                  <div class="services__content__card__header__text">
                    Development
                  </div>
                </div>
                <div class="services__content__card__body">
                  Do you have a design in mind, but not sure how to get it on
                  the internet? Want a website, landing page, component, or
                  widget? Let's talk.
                </div>
              </div>
              <div class="services__content__card">
                <div class="services__content__card__header">
                  <div class="services__content__card__header__icon">
                    <i class="fa-solid fa-gears"></i>
                  </div>
                  <div class="services__content__card__header__text">
                    Systems
                  </div>
                </div>
                <div class="services__content__card__body">
                  Not sure if your business is doing the right things or using
                  the right tools? We'll take a look and see how you can
                  optimize your workflows.
                </div>
              </div>
              <div class="services__content__card">
                <div class="services__content__card__header">
                  <div class="services__content__card__header__icon">
                    <i class="fa-solid fa-handshake-angle"></i>
                  </div>
                  <div class="services__content__card__header__text">
                    Consulting
                  </div>
                </div>
                <div class="services__content__card__body">
                  Do you have a problem that needs solving, but aren't sure
                  where to start? Let us guide you toward the solution.
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="section-gutter"></div>
    </section>
    <Divider />
    <section id="contact" class="section alt-section" role="region" aria-labelledby="contact-heading">
      <div class="section-gutter"></div>
      <div class="section-wrapper">
        <div class="contact__content">
          <div class="badge">Start the conversation</div>
          <h2 id="contact-heading" class="h2">You have ideas. We have solutions.</h2>
          <div class="contact__content__body">
            <div class="body-text">
              Whether you have questions about one of the services above, or
              something else entirely – email us at <a class="inline-link"
                href="mailto:info@omniwerx.io">info@omniwerx.io</a> or drop us a message below, and we'll reach out to
              you.
            </div>
          </div>
          <div class="contact__content__form-wrapper">
            <form id="contactForm" class="contact__content__cta">
              <input type="text" name="name" placeholder="Name" required />
              <input type="email" name="email" placeholder="Email" required />
              <textarea name="message" placeholder="Message" required></textarea>
              <button type="submit" id="submitBtn">Send Message</button>
            </form>
            <div id="formMessage" class="form-message"></div>
          </div>
        </div>
      </div>
      <div class="section-gutter"></div>
    </section>
    <TerminalDivider />
  </main>
  <footer class="section" role="contentinfo">
    <div class="section-gutter"></div>
    <div class="section-wrapper">
      <div class="footer__content">© OMNIWERX 2025. All rights reserved.</div>
    </div>
    <div class="section-gutter"></div>
  </footer>
</body>

<script>
  const navRight = document.querySelector(".nav-right");
  const navToggle = document.querySelector(".nav-mobile-toggle");
  const navLinks = document.querySelectorAll(".nav-link");

  navToggle?.addEventListener("click", () => {
    navRight?.classList.toggle("active");
  });

  navLinks.forEach((link) => {
    link.addEventListener("click", () => {
      navRight?.classList.remove("active");
    });
  });

  // Contact form submission
  const contactForm = document.getElementById("contactForm");
  const submitBtn = document.getElementById("submitBtn");
  const formMessage = document.getElementById("formMessage");

  contactForm?.addEventListener("submit", async (e) => {
    e.preventDefault();

    if (!submitBtn || !formMessage) return;

    // Get form data
    const formData = new FormData(contactForm as HTMLFormElement);
    const data = {
      name: formData.get("name"),
      email: formData.get("email"),
      message: formData.get("message"),
    };

    // Disable submit button and show loading state
    submitBtn.disabled = true;
    submitBtn.textContent = "Sending...";
    formMessage.textContent = "";
    formMessage.className = "form-message";

    try {
      const response = await fetch("/api/contact", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify(data),
      });

      const result = await response.json();

      if (result.success) {
        // Success - clear form and show success message
        (contactForm as HTMLFormElement).reset();
        formMessage.textContent = result.message;
        formMessage.className = "form-message success";
      } else {
        // Error from server
        formMessage.textContent = result.error;
        formMessage.className = "form-message error";
      }
    } catch (error) {
      // Network or other error
      formMessage.textContent =
        "An error occurred. Please try again or email us directly at info@omniwerx.io.";
      formMessage.className = "form-message error";
    } finally {
      // Re-enable submit button
      submitBtn.disabled = false;
      submitBtn.textContent = "Send Message";
    }
  });
</script>

</html>
