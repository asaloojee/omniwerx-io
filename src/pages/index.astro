---
import "../styles/global.css";
import Divider from "../components/Divider.astro";
import PrimaryButton from "../components/PrimaryButton.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>omniwerx</title>
  </head>
  <body>
    <header>
      <nav>
        <a href="/" class="nav__link">Work</a>
        <a href="/" class="nav__link">Services</a>
        <a href="/" class="nav__link">About</a>
      </nav>
    </header>
    <main>
      <img src="/wordmark.svg" alt="" class="hero-wordmark" />
      <section id="hero">
        <h1>Precision-engineered websites and interfaces.</h1>
        <div class="hero__lead">
          <span class="hero__lead--emphasis"
            >We design and build custom websites and digital interfaces for
            startups and founder-led businesses.</span
          > We combine design, development, infrastructure, and business thinking
          to create refined digital experiences that elevate your product and advance
          your brand.
        </div>
        <PrimaryButton href="/">Start a Project</PrimaryButton>
      </section>
      <section id="work">
        <p class="label">Work</p>
        <h2>A selection of our projects.</h2>
      </section>
    </main>
  </body>
</html>
