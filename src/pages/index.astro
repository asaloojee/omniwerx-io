---
import ComposeIcon from "../assets/icons/compose.svg";
import ConnectIcon from "../assets/icons/connect.svg";
import AdjustIcon from "../assets/icons/adjust.svg";
import ContinueIcon from "../assets/icons/continue.svg";
import CompleteIcon from "../assets/icons/complete.svg";
import CheckIcon from "../assets/icons/check.svg";

import BlenderLogo from "../components/BlenderLogo.astro";
import CopyEmail from "../components/CopyEmail.astro";
import FaqAccordion from "../components/FaqAccordion.astro";
import Footer from "../components/Footer.astro";
import Nav from "../components/Nav.astro";
import Divider from "../components/Divider.astro";
import PrimaryButton from "../components/PrimaryButton.astro";
import SectionCorners from "../components/SectionCorners.astro";
import InlineLink from "../components/InlineLink.astro";
import "../styles/global.css";

const faqItems = [
  {
    question: "What is the monthly engagement plan?",
    answer:
      "If you have a lot of ongoing work, this is a way for you to pay a flat fee for all of the items you need done instead of repeatedly scoping separate projects. We work through your requests one at a time, and you can continuously add items to the list, request revisions, or reshuffle priorities.",
  },
  {
    question: "How are one-off projects scoped and billed?",
    answer:
      "First, we sit down to iron out the scope and schedule of the project and agree on a quote. Then, 50% of the payment is due up front, and 50% is due after completion. You will receive a full handoff with clearly outlined next steps.",
  },
  {
    question: "What tools do you use?",
    answer:
      "Our diverse expertise covers everything from low-code platforms like Kajabi and Webflow to fully custom solutions and JavaScript frameworks. We design from scratch, then implement in the context your business is already comfortable with to reduce friction.",
  },
  {
    question: "What happens after a focused build launches?",
    answer:
      "A focused build concludes with launch or handoff. Ongoing support can be arranged separately when maintenance, iteration, or additional development is needed.",
  },
  {
    question: "Do you design for both mobile and desktop?",
    answer:
      "Yes. Responsive design is central to our method. We believe in thorough implementation across a range of screen sizes. Websites should be polished from superwide monitors down to small phones.",
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>omniwerx</title>
  </head>
  <body>
    <header class="page-grid">
      <Nav />
    </header>
    <main>
      <section id="hero" class="page-grid">
        <div class="section-frame">
          <div class="section-content">
            <h1>Precision-engineered websites and interfaces.</h1>
            <div class="hero__lead">
              <span class="hero__lead--emphasis"
                >We design and build custom websites and digital interfaces for
                startups and founder-led businesses.</span
              > From tool integrations to customer flows to brand messaging, we help
              you present your product or service with greater clarity, credibility,
              and polish.
            </div>
            <PrimaryButton href="mailto:info@omniwerx.io"
              >Start a Project</PrimaryButton
            >
          </div>
        </div>
        <Divider />
      </section>
      <section id="work" class="page-grid">
        <div class="section-frame">
          <div class="section-content">
            <p class="label">Work</p>
            <h2>A selection of our completed projects.</h2>
          </div>
          <div class="work__grid">
            <div class="work__grid-row">
              <div class="work__grid-row__index">001</div>
              <img
                src="/clients/pre-script.jpg"
                alt=""
                class="work__grid-row__img"
              />
              <div class="work__grid-row__content">
                <p class="work__grid-row__key">Name:</p>
                <p class="work__grid-row__value">Pre-Script</p>
                <p class="work__grid-row__key">Engagement Type:</p>
                <p class="work__grid-row__value">Retainer</p>
                <p class="work__grid-row__key work__grid-row__key--long">
                  Description:
                </p>
                <p class="work__grid-row__value work__grid-row__value--long">
                  Built new front-end pages and supported email marketing
                  infrastructure. Helped complete a branding overhaul and
                  transition to more custom implementation while assisting with
                  course operations.
                </p>
              </div>
            </div>
            <div class="work__grid-pair">
              <div class="work__grid-row work__grid-row--pair-left">
                <div class="work__grid-row__index">002</div>
                <img
                  src="/clients/spoken-live.jpg"
                  alt=""
                  class="work__grid-row__img"
                />
                <div class="work__grid-row__content">
                  <p class="work__grid-row__key">Name:</p>
                  <p class="work__grid-row__value">Spoken Live</p>
                  <p class="work__grid-row__key">Engagement Type:</p>
                  <p class="work__grid-row__value">Project</p>
                  <p class="work__grid-row__key work__grid-row__key--long">
                    Description:
                  </p>
                  <p class="work__grid-row__value work__grid-row__value--long">
                    Designed and built a bespoke event landing page within an
                    existing WordPress site, including a multi-stage Stripe
                    payment flow powered by a custom API.
                  </p>
                </div>
              </div>

              <div class="work__grid-row work__grid-row--pair-right">
                <div class="work__grid-row__index">003</div>
                <img
                  src="/clients/jc-hp.jpg"
                  alt=""
                  class="work__grid-row__img"
                />
                <div class="work__grid-row__content">
                  <p class="work__grid-row__key">Name:</p>
                  <p class="work__grid-row__value">JC Health & Performance</p>
                  <p class="work__grid-row__key">Engagement Type:</p>
                  <p class="work__grid-row__value">Project</p>
                  <p class="work__grid-row__key work__grid-row__key--long">
                    Description:
                  </p>
                  <p class="work__grid-row__value work__grid-row__value--long">
                    Delivered a complete brand overhaul and custom website for
                    an independent fitness professional, including a new logo,
                    typography, color system, development, and deployment.
                  </p>
                </div>
              </div>
            </div>
          </div>
          <div class="section-rail-spacer" aria-hidden="true"></div>
        </div>
        <Divider />
      </section>
      <section id="pricing" class="page-grid">
        <div class="section-frame">
          <div class="section-content">
            <p class="label">Pricing</p>
            <h2>What a work agreement looks like.</h2>
            <p class="pricing__body">
              Here are some of the things you can expect in a partnership:
            </p>
            <div class="pricing__capabilities">
              <div class="pricing__capabilities--left">
                <div
                  class="pricing__capabilities__item pricing__capabilities__item--header"
                >
                  The customer experience
                </div>
                <p class="pricing__capabilities__item">
                  Websites and landing pages
                </p>
                <p class="pricing__capabilities__item">
                  Responsive interface design
                </p>
                <p class="pricing__capabilities__item">
                  Messaging and content structure
                </p>
                <p class="pricing__capabilities__item">
                  Conversion and customer flows
                </p>
                <div class="pricing__capabilities__spacer"></div>
              </div>
              <div class="pricing__capabilities--right">
                <div
                  class="pricing__capabilities__item pricing__capabilities__item--header"
                >
                  The systems behind it
                </div>
                <p class="pricing__capabilities__item">
                  CMS and commerce integrations
                </p>
                <p class="pricing__capabilities__item">
                  Payments, forms, and data collection
                </p>
                <p class="pricing__capabilities__item">
                  Marketing and email workflows
                </p>
                <p class="pricing__capabilities__item">
                  Deployment and technical support
                </p>
                <div class="pricing__capabilities__spacer"></div>
              </div>
            </div>
            <div class="pricing-card"></div>
            <FaqAccordion items={faqItems} />
          </div>
        </div>
        <Divider />
      </section>
      <section id="about" class="page-grid">
        <div class="section-frame">
          <div class="section-content">
            <p class="label">About</p>
            <h2>A principles-first approach to design and development.</h2>
            <div class="about__body">
              <div class="about__identity">
                <img
                  src="/headshot.jpg"
                  alt="Portrait of Abdurahmaan Saloojee"
                  class="about__headshot"
                  width="160"
                  height="160"
                />
                <div class="about__identity-text">
                  <p class="about__name">Abdurahmaan Saloojee</p>
                  <p class="about__title">Designer-Developer</p>
                  <CopyEmail email="asaloojee@omniwerx.io" />
                </div>
              </div>
              <div class="about__copy">
                <p>
                  I'm a designer and developer from Ottawa, Canada. I'm
                  currently working as a software engineer for <InlineLink
                    href="https://www.pre-script.com"
                    external>Pre-Script&reg;</InlineLink
                  >, a fitness education company.
                </p>
                <p>
                  My background is in development, but I work across a number of
                  fields that are relevant for small businesses, from design to
                  development to communication.
                </p>
                <p>
                  I believe that your work is an expression of who you are. I
                  value precision, meticulousness, and care, and my aim is to
                  show that with every design asset I place and every line of
                  code I write.
                </p>
                <p>
                  If that resonates with you, <InlineLink href="" external
                    >book a call</InlineLink
                  > and let's talk.
                </p>
              </div>
            </div>
            <div class="about__badge">
              <BlenderLogo />
            </div>
          </div>
        </div>
      </section>
    </main>
    <Footer />
  </body>
</html>
