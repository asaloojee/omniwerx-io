---
import { Image } from "astro:assets";
import "../styles/global.css";
import Footer from "../components/Footer.astro";
import InlineLink from "../components/InlineLink.astro";
import notFoundImage from "../assets/images/brand/404.png";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>404 | Omniwerx®</title>
    <meta name="robots" content="noindex, follow" />
    <meta name="theme-color" content="oklch(0.117 0.003 27.557)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>
  <body>
    <main>
      <section class="not-found">
        <div class="meta-row">omnx_404::<em>not_found</em></div>
        <div class="not-found__content">
          <div class="not-found__message">
            <h1>This page does not exist.</h1>
            <p class="not-found__link">
              <InlineLink href="/">Return home</InlineLink>
            </p>
          </div>
          <div class="not-found__image">
            <Image src={notFoundImage} alt="" />
          </div>
        </div>
      </section>
    </main>
    <Footer utilityOnly />
  </body>
</html>

<style>
  :global(body) {
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    block-size: 100svh;
  }

  main {
    grid-template-rows: minmax(0, 1fr);
    min-block-size: 0;
  }

  .not-found {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
    min-block-size: 0;
    border-block-end: var(--rule-primary);
  }

  .not-found__content {
    display: grid;
    grid-template-rows: repeat(2, minmax(0, 1fr));
    min-block-size: 0;
  }

  .not-found__message {
    display: grid;
    align-content: start;
    padding: 2rem 1rem;
  }

  .not-found__image {
    display: grid;
    order: -1;
    align-content: center;
    justify-items: center;
    min-block-size: 0;
    padding: 4rem;
    border-block-end: var(--rule-primary);
  }

  .not-found h1 {
    height: auto;
    min-block-size: 0;
    padding: 0;
    font-weight: 700;
    line-height: var(--leading-1);
    letter-spacing: var(--tracking-vtight);
    color: var(--white--primary);
  }

  .not-found__link {
    margin-block-start: 1rem;
    color: var(--white--primary);
    font-size: var(--text-lead);
  }

  .not-found__image :global(img) {
    display: block;
    inline-size: min(100%, 40rem);
    max-block-size: 100%;
    block-size: auto;
    object-fit: contain;
  }

  @media (max-width: 991px) {
    .not-found__image {
      padding: 2rem 1rem;
    }
  }
</style>
