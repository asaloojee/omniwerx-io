---
import SurveyNav from '../components/SurveyNav.astro';
import Divider from '../components/Divider.astro';
import Footer from '../components/Footer.astro';
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>404 - Page Not Found - OMNIWERX</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="stylesheet" href="/global.css" />
</head>
<body class="error-page">
  <main class="error-main">
    <SurveyNav />
    <Divider first={true} />
    <section class="section error-section">
      <div class="section-gutter"></div>
      <div class="section-wrapper">
        <div class="section-dot section-dot--left section-dot--top"></div>
        <div class="section-dot section-dot--right section-dot--top"></div>
        <div class="section-dot section-dot--left"></div>
        <div class="section-dot section-dot--right"></div>
        <div class="error-content">
          <div class="error-container">
            <div class="error-code">404</div>
          </div>
          <p class="error-message">This page does not exist.</p>
          <a href="/" class="home-link">Home</a>
        </div>
      </div>
      <div class="section-gutter"></div>
    </section>
    <Divider />
  </main>
  <Footer />
</body>
</html>

<style is:global>
  /* Sticky footer layout */
  .error-page {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  .error-main {
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .error-section {
    flex: 1;
  }

  .error-section .section-wrapper {
    padding: 96px 32px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 100%;
  }

  .error-content {
    max-width: 544px;
    margin: 0 auto;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
  }

  .error-container {
    background-color: rgba(204, 0, 24, 0.2);
    border: 2px solid var(--primary-red);
    border-radius: 12px;
    padding: 16px 32px;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .error-code {
    font-family: 'JetBrains Mono', monospace;
    font-style: italic;
    font-size: 64pt;
    font-weight: 700;
    color: var(--primary-red);
    line-height: 1;
  }

  .error-message {
    font-family: 'JetBrains Mono', monospace;
    font-size: 16px;
    font-weight: 300;
    color: var(--body-text);
    text-align: center;
    margin: 0;
  }

  .home-link {
    font-family: 'JetBrains Mono', monospace;
    font-size: 16px;
    font-weight: 500;
    color: var(--body-text--emphasis);
    padding: 0 2px 2px 2px;
    border-bottom: 1px solid var(--body-text--emphasis);
    text-decoration: none;
  }

  @media screen and (max-width: 768px) {
    .error-section .section-wrapper {
      padding: 64px 16px;
    }

    .error-content {
      padding-top: 120px;
    }

    .error-code {
      font-size: 48pt;
    }
  }
</style>
