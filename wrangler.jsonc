{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "omniwerx-io-dev",
  "compatibility_date": "2025-11-26",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./.svelte-kit/cloudflare/_worker.js",
  "assets": {
    "directory": "./.svelte-kit/cloudflare",
    "binding": "ASSETS",
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
  },
  "ratelimits": [
    {
      "name": "CONTACT_FORM_RATE_LIMITER",
      "namespace_id": "1000",
      "simple": {
        "limit": 5,
        "period": 60,
      },
    },
  ],
  "env": {
    "production": {
      "name": "omniwerx-io",
      "ratelimits": [
        {
          "name": "CONTACT_FORM_RATE_LIMITER",
          "namespace_id": "1001",
          "simple": {
            "limit": 5,
            "period": 60,
          },
        },
      ],
      "routes": [
        {
          "pattern": "omniwerx.io/*",
          "zone_name": "omniwerx.io",
        },
        {
          "pattern": "www.omniwerx.io/*",
          "zone_name": "omniwerx.io",
        },
      ],
    },
    "preview": {
      "name": "omniwerx-io-preview",
      "workers_dev": true,
      "ratelimits": [
        {
          "name": "CONTACT_FORM_RATE_LIMITER",
          "namespace_id": "1002",
          "simple": {
            "limit": 5,
            "period": 60,
          },
        },
      ],
    },
  },
}
