{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "omniwerx-io-dev",
  "main": "./src/worker.ts",
  "compatibility_date": "2025-11-26",
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "404-page",
    "run_worker_first": ["/fonts/*"],
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
  },
  "env": {
    "production": {
      "name": "omniwerx-io",
      "workers_dev": false,
      "vars": {
        "ENVIRONMENT": "production",
      },
      "r2_buckets": [
        {
          "bucket_name": "omniwerx-fonts-production",
          "binding": "FONT_BUCKET",
        },
      ],
      "routes": [
        {
          "pattern": "omniwerx.io/*",
          "zone_name": "omniwerx.io",
        },
        {
          "pattern": "www.omniwerx.io/*",
          "zone_name": "omniwerx.io",
        },
      ],
    },
    "preview": {
      "name": "omniwerx-io-preview",
      "workers_dev": true,
      "vars": {
        "ENVIRONMENT": "preview",
      },
    },
  },
}
