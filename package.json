{
  "name": "omniwerx-io",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "preview": "vp preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "prepare": "svelte-kit sync || echo ''",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "fmt": "vp fmt --write .",
    "fmt:check": "vp fmt --check .",
    "lint": "vp lint .",
    "ci": "pnpm run fmt:check && pnpm run lint && pnpm run check && pnpm run build",
    "deploy": "pnpm run build && wrangler deploy --env production",
    "deploy:preview": "pnpm run build && wrangler deploy --env preview"
  },
  "dependencies": {
    "@google/model-viewer": "^4.3.1"
  },
  "devDependencies": {
    "@sveltejs/adapter-cloudflare": "^7.2.9",
    "@sveltejs/kit": "^2.66.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@types/node": "^25.9.4",
    "svelte": "^5.56.3",
    "svelte-check": "^4.6.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vite-plus": "^0.1.24",
    "wrangler": "^4.103.0"
  },
  "packageManager": "pnpm@11.5.0"
}
