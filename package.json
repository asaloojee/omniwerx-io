{
  "name": "omniwerx-io",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "preview": "vp preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "prepare": "svelte-kit sync || echo ''",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "fmt": "vp fmt --write .",
    "fmt:check": "vp fmt --check .",
    "lint": "vp lint .",
    "ci": "pnpm run fmt:check && pnpm run lint && pnpm run check && pnpm run build",
    "deploy": "pnpm run build && wrangler deploy --env production",
    "deploy:preview": "pnpm run build && wrangler deploy --env preview"
  },
  "dependencies": {
    "@google/model-viewer": "^4.2.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-cloudflare": "^7.2.8",
    "@sveltejs/kit": "^2.57.0",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@types/node": "^25.9.1",
    "svelte": "^5.55.2",
    "svelte-check": "^4.4.6",
    "typescript": "^6.0.2",
    "vite": "^8.0.7",
    "vite-plus": "^0.1.21",
    "wrangler": "^4.95.0"
  },
  "packageManager": "pnpm@11.1.2"
}
